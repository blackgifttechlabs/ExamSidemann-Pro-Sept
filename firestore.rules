rules_version = '2';

/*
 * Production Firestore boundary for Exam Sidemann.
 *
 * Deployment prerequisites (do not skip):
 *  - Set `admin: true` only with the Firebase Admin SDK/custom auth claims.
 *  - Set `teacherVerified: true` only after an administrator verifies a teacher.
 *    Self-service profile updates cannot change role or verification status.
 *  - Backfill `published: true` / `approved: true` only on editorial content
 *    that has been reviewed. Extra Lesson classes are the exception: their
 *    publication gate is the administrator-verified teacher account. Global resources additionally need
 *    approved by an administrator. Client-side filtering is not a security boundary;
 *    public queries must include every matching publication where clause.
 *  - Move public user information to a separate, deliberately minimal
 *    `public_profiles` collection before restoring profile search/leaderboards.
 *
 * Firestore will return index-creation links for compound queries. Likely
 * indexes include news(published, createdAt), tutorials(approved, createdAt),
 * classes(approved, subject/province), comments(postId, isHidden, createdAt),
 * and global_resources(published, type, course). Indexes are intentionally not
 * declared here because this repository does not yet contain an audited index
 * manifest.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid in ['lGSiV47o0lRRHiczIhUZR7VRhbb2', 'TrBcEGUjx4huoLVm0cc6iBiw2ak2'] ||
        (request.auth.token.email is string && request.auth.token.email in [
          'prominencek70@gmail.com',
          'prominencek77@gmail.com'
        ])
      );
    }

    // ── Collection Group queries for administrators ─────────────────────────
    match /{path=**}/aiChats/{chatId} {
      allow read, write, delete: if isAdmin();
    }

    function isVerifiedTeacher() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherVerified == true;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function shortText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function optionalText(data, field, maximum) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maximum);
    }

    function validPublicUrl(value) {
      return value is string && value.size() <= 2048 &&
        (value.matches('https://.*') || value.matches('http://.*'));
    }

    function newsIsPublished(postId) {
      return exists(/databases/$(database)/documents/news/$(postId)) &&
        get(/databases/$(database)/documents/news/$(postId)).data.published == true;
    }

    function schoolIsPublished(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.published == true;
    }

    function communityIsApproved(communityId) {
      return exists(/databases/$(database)/documents/communities/$(communityId)) &&
        get(/databases/$(database)/documents/communities/$(communityId)).data.approved == true;
    }

    function isCommunityMember(communityId) {
      return signedIn() && communityIsApproved(communityId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunities is list &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunities.hasAny([communityId]);
    }

    // Full user documents contain email, progress and relationship data. They
    // are private to the account owner and administrators.
    match /users/{userId} {
      allow get: if signedIn() || isAdmin();
      allow list: if signedIn() || isAdmin();

      allow create: if owns(userId) && validNewUser();
      allow update: if isAdmin() || (owns(userId) && validUserSelfUpdate());
      allow delete: if isAdmin();

      function validNewUser() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'firstName', 'lastName', 'email', 'role', 'school', 'grade',
            'educationType', 'course', 'profileCompleted', 'age', 'phone', 'province', 'teacherVerified', 'teacherApplication',
            'enrolledSubjects', 'streak', 'visitCount', 'totalPoints', 'lastLoginDate',
            'completedTopics', 'topicScores', 'friendRequests', 'friends', 'createdAt',
            'parentRequests', 'linkedParents', 'linkedStudents',
            'joinedCommunities', 'photoURL', 'bannerURL'
          ]) &&
          data.keys().hasAll([
            'firstName', 'lastName', 'email', 'role', 'streak',
            'visitCount', 'totalPoints', 'lastLoginDate', 'createdAt'
          ]) &&
          shortText(data.firstName, 80) &&
          shortText(data.lastName, 80) &&
          data.email == request.auth.token.email &&
          data.role in ['student', 'teacher', 'parent'] &&
          data.streak is int && data.streak >= 0 && data.streak <= 1 &&
          data.visitCount == 1 &&
          data.totalPoints == 0 &&
          data.createdAt is timestamp &&
          data.lastLoginDate is timestamp &&
          optionalText(data, 'school', 160) &&
          optionalText(data, 'grade', 80) &&
          optionalText(data, 'course', 160) &&
          (!('profileCompleted' in data) || data.profileCompleted is bool) &&
          optionalText(data, 'phone', 50) &&
          optionalText(data, 'province', 100) &&
          (!('educationType' in data) ||
            data.educationType in ['high-school', 'polytechnic', 'ecd']) &&
          (!('age' in data) ||
            (data.age is int && data.age >= 2 && data.age <= 12)) &&
          optionalText(data, 'photoURL', 400000) &&
          optionalText(data, 'bannerURL', 400000) &&
          (!('enrolledSubjects' in data) ||
            (data.enrolledSubjects is list && data.enrolledSubjects.size() <= 100)) &&
          (!('completedTopics' in data) ||
            (data.completedTopics is map && data.completedTopics.size() <= 1000)) &&
          (!('topicScores' in data) ||
            (data.topicScores is map && data.topicScores.size() <= 1000)) &&
          (!('friendRequests' in data) || data.friendRequests.size() == 0) &&
          (!('friends' in data) || data.friends.size() == 0) &&
          (!('parentRequests' in data) || data.parentRequests.size() == 0) &&
          (!('linkedParents' in data) || data.linkedParents.size() == 0) &&
          (!('linkedStudents' in data) || data.linkedStudents.size() == 0) &&
          (!('joinedCommunities' in data) || data.joinedCommunities.size() == 0) &&
          ((data.role in ['student', 'parent'] &&
              !('teacherVerified' in data) && !('teacherApplication' in data)) ||
            (data.role == 'teacher' &&
              data.teacherVerified == false &&
              data.educationType in ['high-school', 'polytechnic'] &&
              shortText(data.phone, 50) && shortText(data.province, 100) &&
              data.teacherApplication is map &&
              data.teacherApplication.keys().hasOnly([
                'educationType', 'teachingArea', 'primarySubject',
                'qualification', 'status', 'submittedAt'
              ]) &&
              data.teacherApplication.keys().hasAll([
                'educationType', 'teachingArea', 'primarySubject',
                'qualification', 'status', 'submittedAt'
              ]) &&
              data.teacherApplication.educationType == data.educationType &&
              shortText(data.teacherApplication.teachingArea, 160) &&
              data.teacherApplication.primarySubject == data.teacherApplication.teachingArea &&
              shortText(data.teacherApplication.qualification, 240) &&
              data.teacherApplication.status == 'pending' &&
              data.teacherApplication.submittedAt is timestamp));
      }

      function validUserSelfUpdate() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();
        return changed.hasOnly([
            'firstName', 'lastName', 'school', 'grade', 'course', 'profileCompleted', 'educationType', 'enrolledSubjects',
            'photoURL', 'bannerURL', 'streak', 'visitCount', 'lastLoginDate',
            'completedTopics', 'topicScores', 'joinedCommunities'
          ]) &&
          shortText(data.firstName, 80) &&
          shortText(data.lastName, 80) &&
          optionalText(data, 'school', 160) &&
          optionalText(data, 'grade', 80) &&
          optionalText(data, 'course', 160) &&
          (!('profileCompleted' in data) || data.profileCompleted is bool) &&
          (!('educationType' in data) ||
            data.educationType in ['high-school', 'polytechnic', 'ecd']) &&
          optionalText(data, 'photoURL', 400000) &&
          optionalText(data, 'bannerURL', 400000) &&
          (!('enrolledSubjects' in data) ||
            (data.enrolledSubjects is list && data.enrolledSubjects.size() <= 100)) &&
          (!('completedTopics' in data) ||
            (data.completedTopics is map && data.completedTopics.size() <= 1000)) &&
          (!('topicScores' in data) ||
            (data.topicScores is map && data.topicScores.size() <= 1000)) &&
          (!('joinedCommunities' in data) ||
            (data.joinedCommunities is list && data.joinedCommunities.size() <= 100)) &&
          (!('streak' in data) ||
            (data.streak is int && data.streak >= 0 && data.streak <= 10000)) &&
          (!('visitCount' in data) ||
            (data.visitCount is int &&
              data.visitCount >= resource.data.get('visitCount', 0) &&
              data.visitCount <= resource.data.get('visitCount', 0) + 1)) &&
          (!('lastLoginDate' in data) || data.lastLoginDate is timestamp);
      }

      match /resources/{resourceId} {
        allow read, delete: if owns(userId) || isAdmin();
        allow create, update: if (owns(userId) || isAdmin()) && validSavedResource(userId);

        function validSavedResource(ownerId) {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'type', 'title', 'subject', 'content', 'createdAt', 'userId'
            ]) &&
            data.keys().hasAll([
              'type', 'title', 'subject', 'content', 'createdAt', 'userId'
            ]) &&
            data.userId == ownerId &&
            data.type in ['summary', 'quiz', 'exam'] &&
            shortText(data.title, 240) &&
            shortText(data.subject, 160) &&
            data.content is string && data.content.size() <= 200000 &&
            data.createdAt is timestamp;
        }
      }

      // Private adaptive-learning profile. The summary document powers feed
      // ranking across devices; the append-only events retain the underlying
      // interaction metrics (views, dwell time, answers, saves and skips).
      match /personalization/{profileId} {
        allow read, create, update: if owns(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /personalizationEvents/{eventId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if owns(userId) &&
          request.resource.data.keys().hasAll(['type', 'createdAt']) &&
          request.resource.data.type in [
            'impression', 'view', 'answer', 'save', 'skip', 'mastered',
            'subject_activity', 'career_interest', 'exam_date',
            'academic_profile_reset'
          ] &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /quizHistory/{attemptId} {
        allow read, delete: if owns(userId) || isAdmin();
        allow create: if owns(userId) && validQuizAttempt();
        allow update: if false;

        function validQuizAttempt() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'title', 'subject', 'date', 'score', 'totalQuestions',
              'correctCount', 'incorrectCount', 'results'
            ]) &&
            data.keys().hasAll([
              'title', 'subject', 'date', 'score', 'totalQuestions',
              'correctCount', 'incorrectCount', 'results'
            ]) &&
            shortText(data.title, 240) &&
            shortText(data.subject, 160) &&
            data.date == request.time &&
            data.score is number && data.score >= 0 && data.score <= 100000 &&
            data.totalQuestions is int && data.totalQuestions >= 0 && data.totalQuestions <= 500 &&
            data.correctCount is int && data.correctCount >= 0 &&
            data.incorrectCount is int && data.incorrectCount >= 0 &&
            data.correctCount + data.incorrectCount <= data.totalQuestions &&
            data.results is list && data.results.size() <= 500;
        }
      }

      match /activityDays/{dayId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if owns(userId) && validActivityDayCreate(dayId);
        allow update: if owns(userId) && validActivityDayUpdate(dayId);
        allow delete: if isAdmin();

        function validActivityDayShape(dayId) {
          let data = request.resource.data;
          return data.keys().hasOnly(['date', 'visited', 'timeMs', 'updatedAt']) &&
            data.keys().hasAll(['date', 'visited', 'timeMs', 'updatedAt']) &&
            data.date == dayId &&
            data.visited == true &&
            data.timeMs is number &&
            data.timeMs >= 0 &&
            data.updatedAt == request.time;
        }

        function validActivityDayCreate(dayId) {
          return validActivityDayShape(dayId) &&
            request.resource.data.timeMs <= 60000;
        }

        function validActivityDayUpdate(dayId) {
          return validActivityDayShape(dayId) &&
            request.resource.data.timeMs >= resource.data.get('timeMs', 0) &&
            request.resource.data.timeMs <= resource.data.get('timeMs', 0) + 60000;
        }
      }

      // ── AI Chat Sessions ─────────────────────────────────────────────────
      match /aiChats/{chatId} {
        allow read, write, delete: if owns(userId) || isAdmin();
      }

      // ── Daily Token Usage ────────────────────────────────────────────────
      match /aiTokens/{dayId} {
        allow read, write, delete: if owns(userId) || isAdmin();
      }

      // ── AI Saved Notes ───────────────────────────────────────────────────
      match /aiNotes/{noteId} {
        allow read, write, delete: if owns(userId) || isAdmin();
      }


      match /subjectStudyDays/{studyDayId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if owns(userId) && validSubjectStudyDayCreate();
        allow update: if owns(userId) && validSubjectStudyDayUpdate();
        allow delete: if isAdmin();

        function validSubjectStudyDayShape() {
          let data = request.resource.data;
          return data.keys().hasOnly(['date', 'subject', 'subjectKey', 'timeMs', 'updatedAt']) &&
            data.keys().hasAll(['date', 'subject', 'subjectKey', 'timeMs', 'updatedAt']) &&
            data.date is string && data.date.size() == 10 &&
            shortText(data.subject, 160) &&
            shortText(data.subjectKey, 180) &&
            data.timeMs is number &&
            data.timeMs >= 0 &&
            data.updatedAt == request.time;
        }

        function validSubjectStudyDayCreate() {
          return validSubjectStudyDayShape() &&
            request.resource.data.timeMs <= 60000;
        }

        function validSubjectStudyDayUpdate() {
          return validSubjectStudyDayShape() &&
            request.resource.data.timeMs >= resource.data.get('timeMs', 0) &&
            request.resource.data.timeMs <= resource.data.get('timeMs', 0) + 60000;
        }
      }

      match /subjectStudyTotals/{subjectKey} {
        allow read: if owns(userId) || isAdmin();
        allow create: if owns(userId) && validSubjectStudyTotalCreate();
        allow update: if owns(userId) && validSubjectStudyTotalUpdate();
        allow delete: if isAdmin();

        function validSubjectStudyTotalShape() {
          let data = request.resource.data;
          return data.keys().hasOnly(['subject', 'timeMs', 'daysRead', 'updatedAt']) &&
            data.keys().hasAll(['subject', 'timeMs', 'daysRead', 'updatedAt']) &&
            shortText(data.subject, 160) &&
            data.timeMs is number &&
            data.timeMs >= 0 &&
            data.daysRead is number &&
            data.daysRead >= 0 &&
            data.updatedAt == request.time;
        }

        function validSubjectStudyTotalCreate() {
          return validSubjectStudyTotalShape() &&
            request.resource.data.timeMs <= 60000;
        }

        function validSubjectStudyTotalUpdate() {
          return validSubjectStudyTotalShape() &&
            request.resource.data.timeMs >= resource.data.get('timeMs', 0) &&
            request.resource.data.timeMs <= resource.data.get('timeMs', 0) + 60000;
        }
      }

      match /iqTrainerSessions/{sessionId} {
        allow read, delete: if owns(userId) || isAdmin();
        allow create: if owns(userId) && validIqTrainerSession();
        allow update: if false;

        function validIqTrainerSession() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'xp', 'accuracy', 'bestStreak', 'iqScore', 'dailyStreak',
              'completed', 'mode', 'totalPuzzles', 'guesses', 'correct', 'completedAt'
            ]) &&
            data.keys().hasAll([
              'xp', 'accuracy', 'bestStreak', 'iqScore', 'dailyStreak',
              'completed', 'mode', 'totalPuzzles', 'guesses', 'correct', 'completedAt'
            ]) &&
            data.mode in ['standard', 'daily'] &&
            data.xp is int && data.xp >= 0 && data.xp <= 100000 &&
            data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 100 &&
            data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 1000 &&
            data.iqScore is int && data.iqScore >= 0 && data.iqScore <= 200 &&
            data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 10000 &&
            data.completed is int && data.completed >= 0 && data.completed <= 100 &&
            data.totalPuzzles is int && data.totalPuzzles >= 0 && data.totalPuzzles <= 100 &&
            data.guesses is int && data.guesses >= 0 && data.guesses <= 500 &&
            data.correct is int && data.correct >= 0 && data.correct <= 100 &&
            data.completedAt == request.time;
        }
      }

      match /{privateDocument=**} {
        allow read, write: if false;
      }
    }

    /*
     * The deliberately minimal public face of a student, and the thing the
     * leaderboard and "students like you" list read. It exists so those
     * features never need `list` access to /users, which holds email addresses,
     * quiz history and relationships.
     *
     * Everything here is what a classmate would see on a noticeboard: a display
     * name, a school, a level, the subjects taken, a score. No email, no date of
     * birth, no contact details — the field whitelist below is the guarantee,
     * and it is enforced on the way in rather than trusted from the client.
     *
     * A student writes only their own row, and only while signed in. Reading
     * requires being signed in too: rankings are for classmates, not for
     * scrapers.
     */
    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create: if owns(userId) && validPublicProfile();
      allow update: if (owns(userId) && validPublicProfile()) || isAdmin();
      allow delete: if owns(userId) || isAdmin();

      function validPublicProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'displayName', 'photoURL', 'school', 'grade', 'level',
            'subjects', 'totalPoints', 'streak', 'visitCount', 'role', 'updatedAt'
          ]) &&
          data.keys().hasAll(['displayName', 'totalPoints', 'updatedAt']) &&
          shortText(data.displayName, 80) &&
          optionalText(data, 'school', 160) &&
          optionalText(data, 'grade', 80) &&
          optionalText(data, 'level', 80) &&
          optionalText(data, 'photoURL', 400000) &&
          (!('role' in data) || data.role in ['student', 'teacher', 'parent']) &&
          (!('subjects' in data) ||
            (data.subjects is list && data.subjects.size() <= 30)) &&
          data.totalPoints is int && data.totalPoints >= 0 &&
          (!('visitCount' in data) ||
            (data.visitCount is int && data.visitCount >= 0)) &&
          (!('streak' in data) ||
            (data.streak is int && data.streak >= 0 && data.streak <= 10000)) &&
          data.updatedAt == request.time;
      }
    }

    // Deliberately public, administrator-curated site configuration.
    match /config/{configId} {
      allow read: if configId in ['academic_hierarchy', 'school_calendars', 'feature_flags', 'ranking_blacklist'] || isAdmin();
      allow write: if isAdmin();
    }

    match /course_subjects/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_resources/{resourceId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow write: if isAdmin();
    }

    match /global_content/{contentId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /schools/{schoolId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /schoolEditSuggestions/{suggestionId} {
      allow create: if validSchoolSuggestion();
      allow get: if isAdmin() ||
        (signedIn() && resource.data.submittedBy.uid == request.auth.uid);
      allow list, update, delete: if isAdmin();

      function validSchoolSuggestion() {
        let data = request.resource.data;
        return signedIn() &&
          data.keys().hasOnly([
            'schoolId', 'schoolName', 'schoolType', 'province', 'proposed',
            'changes', 'note', 'submittedBy', 'status', 'createdAt'
          ]) &&
          data.keys().hasAll([
            'schoolId', 'schoolName', 'proposed', 'changes', 'note',
            'submittedBy', 'status', 'createdAt'
          ]) &&
          shortText(data.schoolId, 160) && schoolIsPublished(data.schoolId) &&
          shortText(data.schoolName, 240) &&
          optionalText(data, 'schoolType', 80) &&
          optionalText(data, 'province', 100) &&
          data.proposed is map && data.proposed.size() <= 30 &&
          data.changes is map && data.changes.size() > 0 && data.changes.size() <= 30 &&
          data.note is string && data.note.size() <= 2000 &&
          data.submittedBy is map &&
          data.submittedBy.keys().hasOnly(['uid', 'name', 'email']) &&
          data.submittedBy.uid == request.auth.uid &&
          shortText(data.submittedBy.name, 160) &&
          data.submittedBy.email == request.auth.token.email &&
          data.status == 'pending' && data.createdAt == request.time;
      }
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() ||
        (resource.data.approved == true && resource.data.isHidden == false &&
          schoolIsPublished(resource.data.schoolId));
      allow create: if validPendingReview();
      allow update, delete: if isAdmin();

      function validPendingReview() {
        let data = request.resource.data;
        return signedIn() &&
          data.keys().hasOnly([
            'schoolId', 'schoolName', 'rating', 'review', 'userId',
            'userName', 'createdAt', 'approved', 'isHidden'
          ]) &&
          data.keys().hasAll([
            'schoolId', 'rating', 'review', 'userId', 'userName',
            'createdAt', 'approved', 'isHidden'
          ]) &&
          shortText(data.schoolId, 160) && schoolIsPublished(data.schoolId) &&
          optionalText(data, 'schoolName', 240) &&
          data.rating is int && data.rating >= 1 && data.rating <= 5 &&
          data.review is string && data.review.size() <= 2000 &&
          data.userId == request.auth.uid &&
          shortText(data.userName, 160) &&
          data.createdAt == request.time &&
          data.approved == false && data.isHidden == true;
      }
    }

    match /news/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if isAdmin() ||
        (resource.data.isHidden == false && newsIsPublished(resource.data.postId));
      allow create: if validPendingComment();
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid &&
          resource.data.isHidden == true);
      // Reactions and moderation are server/admin operations. This prevents a
      // client from un-hiding itself or rewriting ownership fields.
      allow update: if isAdmin();

      function validPendingComment() {
        let data = request.resource.data;
        return signedIn() &&
          data.keys().hasOnly([
            'postId', 'userId', 'userName', 'text', 'createdAt', 'isHidden',
            'parentId', 'likedBy', 'dislikedBy'
          ]) &&
          data.keys().hasAll([
            'postId', 'userId', 'userName', 'text', 'createdAt', 'isHidden',
            'parentId', 'likedBy', 'dislikedBy'
          ]) &&
          shortText(data.postId, 160) && newsIsPublished(data.postId) &&
          data.userId == request.auth.uid &&
          shortText(data.userName, 160) &&
          shortText(data.text, 2000) &&
          data.createdAt == request.time && data.isHidden == true &&
          (data.parentId == null || shortText(data.parentId, 160)) &&
          data.likedBy is list && data.likedBy.size() == 0 &&
          data.dislikedBy is list && data.dislikedBy.size() == 0;
      }
    }

    match /tutorials/{tutorialId} {
      allow read: if resource.data.approved == true || isAdmin() ||
        (isVerifiedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if validNewTutorial();
      allow update: if isAdmin() || validTeacherTutorialUpdate();
      allow delete: if isAdmin() ||
        (isVerifiedTeacher() && resource.data.teacherId == request.auth.uid);

      function validNewTutorial() {
        let data = request.resource.data;
        return isVerifiedTeacher() &&
          data.keys().hasOnly([
            'title', 'url', 'thumbnail', 'subject', 'grade', 'topic',
            'description', 'duration', 'teacherId', 'teacherName', 'approved', 'views',
            'likes', 'createdAt'
          ]) &&
          data.keys().hasAll([
            'title', 'url', 'thumbnail', 'subject', 'grade', 'topic',
            'description', 'teacherId', 'teacherName', 'approved', 'views',
            'likes', 'createdAt'
          ]) &&
          data.teacherId == request.auth.uid &&
          shortText(data.teacherName, 160) &&
          shortText(data.title, 240) && validPublicUrl(data.url) &&
          validPublicUrl(data.thumbnail) &&
          shortText(data.subject, 160) && shortText(data.grade, 100) &&
          shortText(data.topic, 240) &&
          optionalText(data, 'duration', 40) &&
          data.description is string && data.description.size() <= 10000 &&
          data.approved == false && data.views == 0 && data.likes == 0 &&
          data.createdAt == request.time;
      }

      function validTeacherTutorialUpdate() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();
        return isVerifiedTeacher() &&
          resource.data.teacherId == request.auth.uid &&
          data.teacherId == request.auth.uid &&
          changed.hasOnly([
            'title', 'url', 'thumbnail', 'subject', 'grade', 'topic',
            'description', 'duration', 'teacherName', 'approved'
          ]) &&
          data.approved == false &&
          shortText(data.teacherName, 160) &&
          shortText(data.title, 240) && validPublicUrl(data.url) &&
          validPublicUrl(data.thumbnail) &&
          shortText(data.subject, 160) && shortText(data.grade, 100) &&
          shortText(data.topic, 240) &&
          optionalText(data, 'duration', 40) &&
          data.description is string && data.description.size() <= 10000;
      }
    }

    match /classes/{classId} {
      allow read: if resource.data.approved == true || isAdmin() ||
        (signedIn() &&
          (resource.data.teacherId == request.auth.uid ||
           (resource.data.students is list && resource.data.students.hasAny([request.auth.uid])) ||
           (resource.data.pendingRequests is list && resource.data.pendingRequests.hasAny([request.auth.uid]))));
      allow create: if validNewClass();
      allow update: if isAdmin() || validStudentJoinRequest() ||
        validTeacherRosterUpdate() || validTeacherClassUpdate();
      allow delete: if isAdmin() ||
        (isVerifiedTeacher() && resource.data.teacherId == request.auth.uid);

      function validNewClass() {
        let data = request.resource.data;
        return isVerifiedTeacher() &&
          data.keys().hasOnly([
            'name', 'subject', 'level', 'timetable', 'price', 'period',
            'currency', 'province', 'city', 'suburb', 'phone', 'lat', 'lng',
            'description', 'teacherId', 'teacherName', 'teacherImage', 'students',
            'pendingRequests', 'approved', 'createdAt', 'settings'
          ]) &&
          data.keys().hasAll([
            'name', 'subject', 'level', 'timetable', 'price', 'period',
            'currency', 'teacherId', 'teacherName', 'students',
            'pendingRequests', 'approved', 'createdAt'
          ]) &&
          data.teacherId == request.auth.uid &&
          shortText(data.teacherName, 160) && shortText(data.name, 240) &&
          optionalText(data, 'teacherImage', 400000) &&
          shortText(data.subject, 160) && shortText(data.level, 100) &&
          data.timetable is string && data.timetable.size() <= 1000 &&
          data.price is number && data.price >= 0 && data.price <= 1000000 &&
          data.period in ['week', 'month', 'term'] &&
          data.currency in ['USD', 'ZIG', 'ZiG'] &&
          optionalText(data, 'province', 100) && optionalText(data, 'city', 100) &&
          optionalText(data, 'suburb', 100) && optionalText(data, 'phone', 50) &&
          optionalText(data, 'description', 5000) &&
          (!('lat' in data) || data.lat == null || data.lat is number) &&
          (!('lng' in data) || data.lng == null || data.lng is number) &&
          data.students is list && data.students.size() == 0 &&
          data.pendingRequests is list && data.pendingRequests.size() == 0 &&
          // Teacher verification is the single moderation gate for Extra
          // Lessons. Verified teachers may publish their own listings.
          data.approved == true && data.createdAt == request.time &&
          (!('settings' in data) ||
            (data.settings is map && data.settings.size() <= 10));
      }

      function validStudentJoinRequest() {
        let data = request.resource.data;
        return signedIn() && resource.data.approved == true &&
          data.diff(resource.data).affectedKeys().hasOnly(['pendingRequests']) &&
          resource.data.pendingRequests is list && data.pendingRequests is list &&
          data.pendingRequests.size() == resource.data.pendingRequests.size() + 1 &&
          data.pendingRequests.size() <= 500 &&
          data.pendingRequests.hasAll(resource.data.pendingRequests) &&
          data.pendingRequests.toSet()
            .difference(resource.data.pendingRequests.toSet()) ==
              [request.auth.uid].toSet();
      }

      function validTeacherRosterUpdate() {
        let data = request.resource.data;
        return isVerifiedTeacher() &&
          resource.data.teacherId == request.auth.uid &&
          data.diff(resource.data).affectedKeys().hasOnly(['students', 'pendingRequests']) &&
          resource.data.students is list && data.students is list &&
          resource.data.pendingRequests is list && data.pendingRequests is list &&
          data.students.size() <= 500 && data.pendingRequests.size() <= 500 &&
          data.students.toSet().difference(resource.data.students.toSet())
            .difference(resource.data.pendingRequests.toSet()).size() == 0 &&
          data.pendingRequests.toSet().difference(resource.data.pendingRequests.toSet()).size() == 0;
      }

      function validTeacherClassUpdate() {
        let data = request.resource.data;
        return isVerifiedTeacher() &&
          resource.data.teacherId == request.auth.uid &&
          data.teacherId == request.auth.uid &&
          data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'subject', 'level', 'timetable', 'price', 'period',
            'currency', 'province', 'city', 'suburb', 'phone', 'lat', 'lng',
            'description', 'teacherImage', 'settings', 'approved'
          ]) &&
          data.approved == true &&
          optionalText(data, 'teacherImage', 400000) &&
          shortText(data.name, 240) && shortText(data.subject, 160) &&
          shortText(data.level, 100) &&
          data.timetable is string && data.timetable.size() <= 1000 &&
          data.price is number && data.price >= 0 && data.price <= 1000000 &&
          data.period in ['week', 'month', 'term'] &&
          data.currency in ['USD', 'ZIG', 'ZiG'] &&
          optionalText(data, 'province', 100) && optionalText(data, 'city', 100) &&
          optionalText(data, 'suburb', 100) && optionalText(data, 'phone', 50) &&
          optionalText(data, 'description', 5000);
      }
    }

    match /communities/{communityId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow write: if isAdmin();

      match /messages/{messageId} {
        // Community posting is intentionally paused until reporting and
        // moderation exist. Members see only administrator-approved messages.
        allow read: if isAdmin() ||
          (resource.data.approved == true && isCommunityMember(communityId));
        allow write: if isAdmin();
      }
    }

    match /direct_messages/{messageId} {
      allow read: if isAdmin() ||
        (signedIn() &&
          (resource.data.senderId == request.auth.uid ||
           resource.data.receiverId == request.auth.uid));
      allow create: if validDirectMessage();
      allow update: if isAdmin() || validReadReceipt();
      allow delete: if isAdmin();

      function validDirectMessage() {
        let data = request.resource.data;
        return signedIn() &&
          data.keys().hasOnly([
            'text', 'imageBase64', 'senderId', 'receiverId', 'chatId',
            'timestamp', 'read'
          ]) &&
          data.keys().hasAll([
            'text', 'senderId', 'receiverId', 'chatId', 'timestamp', 'read'
          ]) &&
          data.senderId == request.auth.uid &&
          shortText(data.receiverId, 160) && data.receiverId != request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(data.receiverId)) &&
          shortText(data.text, 2000) &&
          data.chatId is string &&
          (data.chatId == data.senderId + '_' + data.receiverId ||
           data.chatId == data.receiverId + '_' + data.senderId) &&
          data.timestamp == request.time && data.read == false &&
          (!('imageBase64' in data) ||
            (data.imageBase64 is string && data.imageBase64.size() <= 700000));
      }

      function validReadReceipt() {
        let data = request.resource.data;
        return signedIn() && resource.data.receiverId == request.auth.uid &&
          data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
          resource.data.read == false && data.read == true;
      }
    }

    /*
     * Visitor analytics.
     *
     * These are counter documents, not an event log, and they are written by
     * visitors who are not signed in — the site is public, so collection has to
     * work before anybody logs in. That makes the write rules the whole
     * boundary, so they are deliberately narrow:
     *
     *  - only the counter fields below may appear, nothing free-form;
     *  - a counter may only ever go up, and only by a small step per write,
     *    so a single request cannot post a million visits;
     *  - timestamps must be the server's own clock;
     *  - reading any of it requires an administrator.
     *
     * A determined script can still add visits one write at a time, the way it
     * could with any client-side analytics. Turn on Firebase App Check to close
     * that off — these rules assume it may not be on yet.
     */
    function analyticsDay(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function analyticsPath(value) {
      return value is string && value.size() > 0 && value.size() <= 300 &&
        value.matches('^/.*');
    }

    function analyticsSource(value) {
      return value is string && value.size() > 0 && value.size() <= 120 &&
        value.matches('^[a-z0-9][a-z0-9.-]*$');
    }

    // Counters are read out of the post-merge document, so a missing field is
    // simply zero on both sides of the comparison.
    function counterStart(field, cap) {
      let next = request.resource.data.get(field, 0);
      return next is number && next >= 0 && next <= cap;
    }

    function counterGrowth(field, cap) {
      let next = request.resource.data.get(field, 0);
      let previous = resource.data.get(field, 0);
      return next is number && next >= previous && next <= previous + cap;
    }

    // One page view per write, with slack for a retried batch.
    function viewStep() {
      return 5;
    }

    // One engagement flush covers at most a few minutes of reading.
    function timeStep() {
      return 1800000;
    }

    match /analytics_daily/{dayId} {
      function dailyShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'views', 'visitors', 'newVisitors', 'sessions', 'timeMs',
            'deviceMobile', 'deviceTablet', 'deviceDesktop',
            'refDirect', 'refSearch', 'refSocial', 'refOther', 'updatedAt'
          ]) &&
          analyticsDay(data.date) && data.date == dayId &&
          data.updatedAt == request.time;
      }

      function dailyStart() {
        return counterStart('views', viewStep()) &&
          counterStart('visitors', viewStep()) &&
          counterStart('newVisitors', viewStep()) &&
          counterStart('sessions', viewStep()) &&
          counterStart('timeMs', timeStep()) &&
          counterStart('deviceMobile', viewStep()) &&
          counterStart('deviceTablet', viewStep()) &&
          counterStart('deviceDesktop', viewStep()) &&
          counterStart('refDirect', viewStep()) &&
          counterStart('refSearch', viewStep()) &&
          counterStart('refSocial', viewStep()) &&
          counterStart('refOther', viewStep());
      }

      function dailyGrowth() {
        return counterGrowth('views', viewStep()) &&
          counterGrowth('visitors', viewStep()) &&
          counterGrowth('newVisitors', viewStep()) &&
          counterGrowth('sessions', viewStep()) &&
          counterGrowth('timeMs', timeStep()) &&
          counterGrowth('deviceMobile', viewStep()) &&
          counterGrowth('deviceTablet', viewStep()) &&
          counterGrowth('deviceDesktop', viewStep()) &&
          counterGrowth('refDirect', viewStep()) &&
          counterGrowth('refSearch', viewStep()) &&
          counterGrowth('refSocial', viewStep()) &&
          counterGrowth('refOther', viewStep());
      }

      // Readable by anyone: the dashboard opens for whoever finds the footer
      // shortcut, so it cannot depend on a signed-in administrator. Deleting
      // still cannot happen from the outside.
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if dailyShape() && dailyStart();
      allow update: if dailyShape() && dailyGrowth();
    }

    // Small hourly buckets power Today's chart without scanning raw sessions.
    match /analytics_hourly/{rowId} {
      function hourlyShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'hour', 'views', 'sessions', 'timeMs', 'updatedAt'
          ]) &&
          analyticsDay(data.date) &&
          data.hour is int && data.hour >= 0 && data.hour <= 23 &&
          data.updatedAt == request.time;
      }

      allow read: if true;
      allow delete: if isAdmin();
      allow create: if hourlyShape() &&
        counterStart('views', viewStep()) &&
        counterStart('sessions', viewStep()) &&
        counterStart('timeMs', timeStep());
      allow update: if hourlyShape() &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.hour == resource.data.hour &&
        counterGrowth('views', viewStep()) &&
        counterGrowth('sessions', viewStep()) &&
        counterGrowth('timeMs', timeStep());
    }

    match /analytics_page_daily/{rowId} {
      function pageDayShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'path', 'title', 'views', 'visitors', 'timeMs', 'updatedAt'
          ]) &&
          analyticsDay(data.date) && analyticsPath(data.path) &&
          optionalText(data, 'title', 200) &&
          data.updatedAt == request.time;
      }

      // Readable by anyone: the dashboard opens for whoever finds the footer
      // shortcut, so it cannot depend on a signed-in administrator. Deleting
      // still cannot happen from the outside.
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if pageDayShape() &&
        counterStart('views', viewStep()) &&
        counterStart('visitors', viewStep()) &&
        counterStart('timeMs', timeStep());
      allow update: if pageDayShape() &&
        request.resource.data.path == resource.data.path &&
        counterGrowth('views', viewStep()) &&
        counterGrowth('visitors', viewStep()) &&
        counterGrowth('timeMs', timeStep());
    }

    match /analytics_pages/{pageId} {
      function pageShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'path', 'title', 'views', 'timeMs', 'lastViewedAt', 'updatedAt'
          ]) &&
          analyticsPath(data.path) &&
          optionalText(data, 'title', 200) &&
          data.updatedAt == request.time &&
          (!('lastViewedAt' in data) || data.lastViewedAt == request.time);
      }

      // Readable by anyone: the dashboard opens for whoever finds the footer
      // shortcut, so it cannot depend on a signed-in administrator. Deleting
      // still cannot happen from the outside.
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if pageShape() &&
        counterStart('views', viewStep()) &&
        counterStart('timeMs', timeStep());
      allow update: if pageShape() &&
        request.resource.data.path == resource.data.path &&
        counterGrowth('views', viewStep()) &&
        counterGrowth('timeMs', timeStep());
    }

    // Privacy-safe experiment engagement. These documents contain only
    // aggregate counters per experiment route; no account or visitor ids.
    match /analytics_experiment_daily/{rowId} {
      function experimentDayShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'path', 'title', 'views', 'timeMs', 'buttonClicks',
            'newUsers', 'returningUsers', 'repeatVisits', 'updatedAt'
          ]) &&
          analyticsDay(data.date) && analyticsPath(data.path) &&
          data.path.matches('^/practicals/.*') &&
          optionalText(data, 'title', 200) &&
          data.updatedAt == request.time;
      }

      allow read: if true;
      allow delete: if isAdmin();
      allow create: if experimentDayShape() &&
        counterStart('views', viewStep()) &&
        counterStart('timeMs', timeStep()) &&
        counterStart('buttonClicks', viewStep()) &&
        counterStart('newUsers', viewStep()) &&
        counterStart('returningUsers', viewStep()) &&
        counterStart('repeatVisits', viewStep());
      allow update: if experimentDayShape() &&
        request.resource.data.path == resource.data.path &&
        counterGrowth('views', viewStep()) &&
        counterGrowth('timeMs', timeStep()) &&
        counterGrowth('buttonClicks', viewStep()) &&
        counterGrowth('newUsers', viewStep()) &&
        counterGrowth('returningUsers', viewStep()) &&
        counterGrowth('repeatVisits', viewStep());
    }

    match /analytics_experiments/{experimentId} {
      function experimentShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'path', 'title', 'views', 'timeMs', 'buttonClicks',
            'newUsers', 'returningUsers', 'repeatVisits', 'updatedAt'
          ]) &&
          analyticsPath(data.path) && data.path.matches('^/practicals/.*') &&
          optionalText(data, 'title', 200) && data.updatedAt == request.time;
      }

      allow read: if true;
      allow delete: if isAdmin();
      allow create: if experimentShape() &&
        counterStart('views', viewStep()) &&
        counterStart('timeMs', timeStep()) &&
        counterStart('buttonClicks', viewStep()) &&
        counterStart('newUsers', viewStep()) &&
        counterStart('returningUsers', viewStep()) &&
        counterStart('repeatVisits', viewStep());
      allow update: if experimentShape() &&
        request.resource.data.path == resource.data.path &&
        counterGrowth('views', viewStep()) &&
        counterGrowth('timeMs', timeStep()) &&
        counterGrowth('buttonClicks', viewStep()) &&
        counterGrowth('newUsers', viewStep()) &&
        counterGrowth('returningUsers', viewStep()) &&
        counterGrowth('repeatVisits', viewStep());
    }

    // Sessions and views per country. The country is derived from the
    // visitor's own timezone, so it is a two-letter code or `ZZ` for a
    // timezone we do not recognise — never a coordinate, never an address.
    match /analytics_geo_daily/{rowId} {
      function geoShape() {
        let data = request.resource.data;
        return data.keys().hasOnly(['date', 'country', 'sessions', 'views', 'updatedAt']) &&
          analyticsDay(data.date) &&
          data.country is string && data.country.matches('^[A-Z]{2}$') &&
          data.updatedAt == request.time;
      }

      allow read: if true;
      allow delete: if isAdmin();
      allow create: if geoShape() &&
        counterStart('sessions', viewStep()) &&
        counterStart('views', viewStep());
      allow update: if geoShape() &&
        request.resource.data.country == resource.data.country &&
        counterGrowth('sessions', viewStep()) &&
        counterGrowth('views', viewStep());
    }

    // A privacy-safe referrer breakdown: a known service key (such as google
    // or whatsapp), or only the hostname for another website. Referring paths,
    // query strings and search terms are never stored.
    match /analytics_source_daily/{rowId} {
      function sourceShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'category', 'source', 'sessions', 'updatedAt'
          ]) &&
          analyticsDay(data.date) &&
          data.category in ['search', 'social', 'other'] &&
          analyticsSource(data.source) &&
          data.updatedAt == request.time;
      }

      allow read: if true;
      allow delete: if isAdmin();
      allow create: if sourceShape() && counterStart('sessions', viewStep());
      allow update: if sourceShape() &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.source == resource.data.source &&
        counterGrowth('sessions', viewStep());
    }

    // Consent-aware, pseudonymous page-level visit records. These are the only
    // analytics documents that can contain browser-provided coordinates, so
    // unlike aggregate counters they are readable only by an authenticated
    // administrator and expire through the configured Firestore TTL policy.
    match /analytics_page_visits/{visitId} {
      function visitShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'path', 'title', 'visitorId', 'sessionId', 'isNewVisitor',
            'device', 'country', 'openedAt', 'lastSeenAt', 'closedAt',
            'durationMs', 'exitType', 'locationStatus', 'latitude', 'longitude',
            'accuracy', 'placeName', 'formattedAddress', 'province', 'district',
            'locality', 'expiresAt', 'updatedAt'
          ]) &&
          data.keys().hasAll([
            'date', 'path', 'title', 'visitorId', 'sessionId', 'isNewVisitor',
            'device', 'country', 'openedAt', 'lastSeenAt', 'durationMs',
            'locationStatus', 'expiresAt', 'updatedAt'
          ]) &&
          analyticsDay(data.date) && analyticsPath(data.path) &&
          optionalText(data, 'title', 200) &&
          shortText(data.visitorId, 40) && shortText(data.sessionId, 40) &&
          data.isNewVisitor is bool &&
          data.device in ['mobile', 'tablet', 'desktop'] &&
          data.country is string && data.country.matches('^[A-Z]{2}$') &&
          data.openedAt is timestamp && data.lastSeenAt is timestamp &&
          (!('closedAt' in data) || data.closedAt is timestamp) &&
          (!('exitType' in data) || data.exitType in ['navigation', 'pagehide', 'untracked']) &&
          data.locationStatus in ['pending', 'granted', 'denied', 'unavailable', 'not-consented'] &&
          data.durationMs is number && data.durationMs >= 0 &&
          (!('latitude' in data) ||
            (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
          (!('longitude' in data) ||
            (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
          (!('accuracy' in data) ||
            (data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000)) &&
          optionalText(data, 'placeName', 160) &&
          optionalText(data, 'formattedAddress', 300) &&
          optionalText(data, 'province', 160) &&
          optionalText(data, 'district', 160) &&
          optionalText(data, 'locality', 160) &&
          data.expiresAt is timestamp && data.updatedAt == request.time &&
          (data.locationStatus != 'granted' ||
            ('latitude' in data && 'longitude' in data));
      }

      allow read, delete: if isAdmin();
      allow create: if visitShape() &&
        request.resource.data.openedAt == request.time &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.durationMs == 0 &&
        request.resource.data.locationStatus == 'pending' &&
        !('closedAt' in request.resource.data);
      allow update: if visitShape() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastSeenAt', 'closedAt', 'durationMs', 'exitType', 'locationStatus',
          'latitude', 'longitude', 'accuracy', 'placeName', 'formattedAddress',
          'province', 'district', 'locality', 'updatedAt'
        ]) &&
        counterGrowth('durationMs', timeStep());
    }

    // One document per visit. Nothing here identifies a person: a random id,
    // the page being read, and a coarse device/source label. Set a Firestore
    // TTL policy on `expiresAt` so these clear themselves out.
    match /analytics_sessions/{sessionId} {
      function sessionShape() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'path', 'title', 'landing', 'device', 'referrer', 'country',
            'referrerSource', 'views', 'timeMs', 'startedAt', 'lastSeenAt', 'expiresAt'
          ]) &&
          analyticsPath(data.path) &&
          optionalText(data, 'title', 200) &&
          data.lastSeenAt == request.time &&
          (!('date' in data) || analyticsDay(data.date)) &&
          (!('landing' in data) || analyticsPath(data.landing)) &&
          (!('device' in data) ||
            data.device in ['mobile', 'tablet', 'desktop']) &&
          (!('referrer' in data) ||
            data.referrer in ['direct', 'search', 'social', 'other']) &&
          (!('referrerSource' in data) || analyticsSource(data.referrerSource)) &&
          (!('country' in data) ||
            (data.country is string && data.country.matches('^[A-Z]{2}$'))) &&
          (!('startedAt' in data) || data.startedAt is timestamp) &&
          (!('expiresAt' in data) || data.expiresAt is timestamp);
      }

      // Readable by anyone: the dashboard opens for whoever finds the footer
      // shortcut, so it cannot depend on a signed-in administrator. Deleting
      // still cannot happen from the outside.
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if sessionShape() &&
        request.resource.data.startedAt == request.time &&
        counterStart('views', viewStep()) &&
        counterStart('timeMs', timeStep());
      allow update: if sessionShape() &&
        counterGrowth('views', viewStep()) &&
        counterGrowth('timeMs', timeStep());
    }

    // Account automation is accessed only through the authenticated server API.
    // Admin SDK writes bypass these rules; browsers cannot forge verification jobs.
    match /admin_settings/{document} { allow read, write: if false; }
    match /email_outbox/{document} { allow read, write: if false; }
    match /email_limits/{document} { allow read, write: if false; }
    match /automation_workers/{document} { allow read, write: if false; }

    // Anything not explicitly listed above remains private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
