# Server-only. Copy into .env.local. Never prefix these with VITE_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME=Exam Sidemann
SITE_URL=https://www.examsidemann.com
# Local dotenv: single-quote the entire JSON. Vercel: paste raw JSON, no outer quotes.
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"testing-3d5b2","client_email":"YOUR_SERVICE_ACCOUNT","private_key":"YOUR_PRIVATE_KEY"}'
# Optional second user database:
# FIREBASE_SECONDARY_SERVICE_ACCOUNT_JSON='{"project_id":"examsidemann-login-4ec4f","client_email":"YOUR_SERVICE_ACCOUNT","private_key":"YOUR_PRIVATE_KEY"}'
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters-long
