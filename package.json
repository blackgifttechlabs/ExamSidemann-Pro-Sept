  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generateLearningOutcomeTitles.mjs && node scripts/generatePracticalTopicSeo.mjs && vite",
    "build": "node scripts/generateLearningOutcomeTitles.mjs && node scripts/generatePracticalTopicSeo.mjs && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build && node scripts/generateSeo.mjs && node scripts/generateServiceWorker.mjs",
    "preview": "vite preview",
    "csharp:build": "node scripts/buildBrowserCSharp.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit",
    "registry:export": "node scripts/exportSchoolRegistry.mjs",
    "registry:verify": "node scripts/validateSchoolRegistry.mjs",
    "seo:verify": "node scripts/checkLearningOutcomeRoutes.mjs && node scripts/checkUploadedQuestionPapers.mjs && node scripts/validateSeo.mjs",
    "numbers:map": "node scripts/buildNumberVoiceMap.mjs",
    "structure:verify": "node scripts/validateStructure.mjs",
    "verify": "npm run structure:verify && npm run build && npm run seo:verify",
    "ecd:audio": "node scripts/prepareEcdAudio.mjs",
    "predev": "npm run ecd:audio",
    "prebuild": "npm run ecd:audio",
    "ecd:verify": "npm run ecd:audio && node scripts/verifyEcd.mjs",
    "ecd:audio:addition": "node scripts/generateEcdAdditionAudio.mjs",
    "ecd:audio:subtraction": "node scripts/generateEcdMonsterAudio.mjs --operation=subtraction",
    "ecd:audio:all": "npm run ecd:audio && node scripts/generateEcdMonsterAudio.mjs --scope=all",
    "ecd:audio:reading": "npm run ecd:audio && node scripts/generateEcdMonsterAudio.mjs --scope=reading",
    "ecd:audio:reading:complete": "npm run ecd:audio && node scripts/generateEcdMonsterAudio.mjs --scope=reading --lesson=meet-letters && node scripts/verifyEcdReadingAudio.mjs meet-letters && node scripts/generateEcdMonsterAudio.mjs --scope=reading --lesson=phonics && node scripts/verifyEcdReadingAudio.mjs phonics && node scripts/generateEcdMonsterAudio.mjs --scope=reading --lesson=rhyming && node scripts/verifyEcdReadingAudio.mjs rhyming && node scripts/generateEcdMonsterAudio.mjs --scope=reading --lesson=sight-words && node scripts/verifyEcdReadingAudio.mjs sight-words && node scripts/generateEcdMonsterAudio.mjs --scope=reading --lesson=cvc && node scripts/verifyEcdReadingAudio.mjs cvc"
  },
