// ──────────────────────────────────────────────────────────────────────────────
// SECTION TABS FOR NAVIGATION
// ──────────────────────────────────────────────────────────────────────────────
const SECTION_TABS = [
  { id: 'intro', label: 'Intro' },
  { id: 'searching', label: 'Searching' },
  { id: 'search-comparison', label: 'Search Comparison' },
  { id: 'sorting', label: 'Sorting' },
  { id: 'sorting-comparison', label: 'Sort Comparison' },
  { id: 'exam-tips', label: 'Exam Tips' },
];

const DARK_KW = new Set(['int', 'void', 'char', 'if', 'else', 'return', 'for', 'while', 'bool', 'using', 'namespace', 'include', 'cout', 'endl', 'sizeof']);

const Hl: React.FC<{ c?: string; children: React.ReactNode }> = ({ c = 'text-yellow-300', children }) => (
  <span className={`rounded-md bg-slate-900 px-2 py-0.5 text-[0.95em] font-extrabold tracking-tight shadow-sm ring-1 ring-slate-700 [box-decoration-break:clone] dark:bg-black dark:ring-slate-600 ${c}`}>{children}</span>
);

const DarkCode: React.FC<{ code: string; title?: string }> = ({ code, title }) => (
  <div className="overflow-hidden rounded-xl border-2 border-indigo-400 bg-slate-900 shadow-lg">
    {title && <div className="border-b border-slate-700 px-3 py-1.5 font-mono text-xs font-bold text-slate-400">{title}</div>}
    <div className="overflow-x-auto px-2 py-3 font-mono text-xs font-semibold leading-6 text-white sm:text-sm sm:leading-7">
      {code.split('\n').map((line, i) => {
        const nodes: React.ReactNode[] = [];
        let last = 0;
        for (const m of line.matchAll(/\/\/.*|"[^"]*"|\d+|[A-Za-z_]\w*/g)) {
          const at = m.index ?? 0;
          if (at > last) nodes.push(line.slice(last, at));
          const t = m[0];
          let cls = '';
          if (t.startsWith('//')) cls = 'font-medium italic text-emerald-400';
          else if (t.startsWith('"')) cls = 'text-orange-300';
          else if (/^\d/.test(t)) cls = 'text-lime-300';
          else if (DARK_KW.has(t)) cls = 'text-sky-300';
          else if (line[at + t.length] === '(') cls = 'text-fuchsia-300';
          nodes.push(<span key={at} className={cls}>{t}</span>);
          last = at + t.length;
        }
        if (last < line.length) nodes.push(line.slice(last));
        return (
          <div key={i} className="flex border-l-4 border-transparent px-2">
            <span aria-hidden="true" className="mr-3 w-5 shrink-0 select-none text-right text-slate-500">{i + 1}</span>
            <code className="whitespace-pre">{nodes.length ? nodes : ' '}</code>
          </div>
        );
      })}
    </div>
  </div>
);

// ──────────────────────────────────────────────────────────────────────────────
// LINEAR SEARCH ANIMATED DIAGRAM
// ──────────────────────────────────────────────────────────────────────────────
const LINEAR_SEARCH_DEMO_ARRAY = [4, 9, 15, 22, 6, 31, 18, 2, 27, 11];
const LINEAR_SEARCH_DEMO_TARGET = 18;

function makePoolBallTexture(text: string, ballColor: string): THREE.CanvasTexture {
  const size = 512;
  const canvas = document.createElement('canvas');
  canvas.width = size * 2;
  canvas.height = size;
  const ctx = canvas.getContext('2d')!;

  // Base ball color across the whole equirectangular wrap
  ctx.fillStyle = ballColor;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Subtle vertical shading for a glossy sphere feel
  const shade = ctx.createLinearGradient(0, 0, 0, canvas.height);
  shade.addColorStop(0, 'rgba(255,255,255,0.18)');
  shade.addColorStop(0.5, 'rgba(255,255,255,0)');
  shade.addColorStop(1, 'rgba(0,0,0,0.15)');
  ctx.fillStyle = shade;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // White circle patch, centered on the front-facing point of the sphere.
  const cx = canvas.width * 0.29;
  const cy = canvas.height / 2;
  const r = size * 0.24;

  ctx.beginPath();
  ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.fillStyle = '#f8fafc';
  ctx.fill();
  ctx.lineWidth = size * 0.012;
  ctx.strokeStyle = '#0f172a';
  ctx.stroke();

  // Number, bold black, centered in the white circle
  ctx.fillStyle = '#0f172a';
  ctx.font = `800 ${Math.floor(r * 1.15)}px monospace`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(text, cx, cy + r * 0.06);

  const tex = new THREE.CanvasTexture(canvas);
  tex.anisotropy = 4;
  tex.needsUpdate = true;
  return tex;
}

const STAGE_X = -3;    // where the ball being checked sits
const TARGET_X = 3;    // where the 18 ball sits
const STAGE_Y = 4.8;

function makeEqualsTexture(mode: 'plain' | 'slash' | 'ok'): THREE.CanvasTexture {
  const c = document.createElement('canvas');
  c.width = 256;
  c.height = 256;
  const ctx = c.getContext('2d')!;
  ctx.lineCap = 'round';
  ctx.strokeStyle = mode === 'ok' ? '#10b981' : '#334155';
  ctx.lineWidth = 34;
  ctx.beginPath(); ctx.moveTo(48, 98);  ctx.lineTo(208, 98);  ctx.stroke();
  ctx.beginPath(); ctx.moveTo(48, 158); ctx.lineTo(208, 158); ctx.stroke();
  if (mode === 'slash') {
    ctx.strokeStyle = '#ef4444';
    ctx.lineWidth = 26;
    ctx.beginPath(); ctx.moveTo(196, 30); ctx.lineTo(60, 226); ctx.stroke();
  }
  const tex = new THREE.CanvasTexture(c);
  tex.needsUpdate = true;
  return tex;
}

type SearchPhase = 'rise' | 'compare' | 'correct' | 'wrong' | 'remove' | 'lower' | 'recentre' | 'highlight' | 'done' | 'reset';

const PHASE_COLORS: Record<string, string> = {
  idle: '#2563eb',
  active: '#fbbf24',
  correct: '#34d399',
  wrong: '#f87171',
  past: '#93c5fd',
};

const BALL_PALETTE = [
  '#eab308', // yellow
  '#2563eb', // blue
  '#dc2626', // red
  '#7c3aed', // purple
  '#ea580c', // orange
  '#16a34a', // green
  '#991b1b', // maroon
  '#1e293b', // charcoal
  '#0891b2', // teal
  '#db2777', // magenta
];

function makeIndexTexture(i: number): THREE.CanvasTexture {
  const c = document.createElement('canvas');
  c.width = 128;
  c.height = 128;
  const ctx = c.getContext('2d')!;
  ctx.fillStyle = '#94a3b8';
  ctx.font = '700 84px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(String(i), 64, 68);
  const tex = new THREE.CanvasTexture(c);
  tex.needsUpdate = true;
  return tex;
}

const SearchControls: React.FC<{
  playing: boolean;
  setPlaying: React.Dispatch<React.SetStateAction<boolean>>;
  speed: number;
  setSpeed: (v: number) => void;
  onRestart: () => void;
}> = ({ playing, setPlaying, speed, setSpeed, onRestart }) => (
  <>
    <button
      type="button"
      onClick={() => setPlaying((v) => !v)}
      className="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-bold text-white shadow-sm hover:bg-indigo-700"
    >
      {playing ? '⏸ Pause' : '▶ Play'}
    </button>
    <button
      type="button"
      onClick={onRestart}
      className="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-50"
    >
      ↻ Restart
    </button>
    <div className="flex items-center gap-1 rounded-lg border border-slate-300 bg-white p-1">
      <span className="px-1 text-[10px] font-bold uppercase text-slate-400">Speed</span>
      {[0.5, 1, 2, 3].map((v) => (
        <button
          key={v}
          type="button"
          onClick={() => setSpeed(v)}
          className={`rounded-md px-2 py-1 text-xs font-bold ${speed === v ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100'}`}
        >
          {v}x
        </button>
      ))}
    </div>
  </>
);

const LinearSearchAnimation: React.FC = () => {
  const arr = LINEAR_SEARCH_DEMO_ARRAY;
  const target = LINEAR_SEARCH_DEMO_TARGET;

  const [currentIndex, setCurrentIndex] = useState(0);
  const [phase, setPhase] = useState<SearchPhase>('rise');
  const [playing, setPlaying] = useState(true);
  const [speed, setSpeed] = useState(1);
  const speedRef = useRef(1);
  speedRef.current = speed;

  const mountRef = useRef<HTMLDivElement>(null);
  const cubesRef = useRef<THREE.Mesh[]>([]);
  const signRef = useRef<{ sprite: THREE.Sprite; tex: Record<string, THREE.CanvasTexture> } | null>(null);
  const targetsRef = useRef<{ y: number; scale: number; colorHex: string; fx: string; x?: number; fxStart?: number }[]>([]);

  // Timeline: rise -> compare -> correct|wrong -> lower -> next index (or done/reset)
  useEffect(() => {
    if (!playing) return;
    const tmo = (fn: () => void, ms: number) => setTimeout(fn, ms / speed);
    let t: ReturnType<typeof setTimeout>;
    const isMatch = arr[currentIndex] === target;

    if (phase === 'rise') {
      t = tmo(() => setPhase('compare'), 550);
    } else if (phase === 'compare') {
      t = tmo(() => setPhase(isMatch ? 'correct' : 'wrong'), 450);
    } else if (phase === 'correct') {
      t = tmo(() => setPhase('done'), 1400);
    } else if (phase === 'wrong') {
      t = tmo(() => setPhase('lower'), 1400);
    } else if (phase === 'lower') {
      t = tmo(() => {
        if (currentIndex + 1 < arr.length) {
          setCurrentIndex((i) => i + 1);
          setPhase('rise');
        } else {
          setPhase('reset');
        }
      }, 450);
    } else if (phase === 'done') {
      t = tmo(() => setPhase('reset'), 1600);
    } else if (phase === 'reset') {
      t = tmo(() => {
        setCurrentIndex(0);
        setPhase('rise');
      }, 700);
    }
    return () => clearTimeout(t);
  }, [phase, currentIndex, arr, target, playing, speed]);

  const isSettled = phase === 'correct' || phase === 'done';
  const isChecking = phase === 'rise' || phase === 'compare';
  const isWrong = phase === 'wrong';

  let message = '';
  if (phase === 'reset') {
    message = 'Restarting search…';
  } else if (isSettled) {
    message = `Found ${target} at index ${currentIndex}!`;
  } else if (isWrong) {
    message = `${arr[currentIndex]} ≠ ${target} — not a match`;
  }

  // Set up scene once
  useEffect(() => {
    const mount = mountRef.current;
    if (!mount) return;

    const width = mount.clientWidth;
    const calcH = (w: number) => Math.round(Math.min(400, Math.max(200, w * 0.5)));
    let height = calcH(width);
    mount.style.height = height + 'px';

    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#ffffff');

    // Narrow FOV + far camera distance flattens perspective, so every ball
    // in the row appears to face the camera equally (no edge-ball skew).
    const camera = new THREE.PerspectiveCamera(22, width / height, 0.1, 200);
    const fitCamera = (w: number, h: number) => {
      const z = Math.max(32, 12.5 / (Math.tan((11 * Math.PI) / 180) * (w / h)));
      camera.position.set(0, z * 0.36, z);
      camera.lookAt(0, 2.0, 0);
    };
    fitCamera(width, height);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    mount.innerHTML = '';
    mount.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const key = new THREE.DirectionalLight(0xffffff, 0.9);
    key.position.set(4, 6, 6);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xffffff, 0.35);
    fill.position.set(-5, 3, 2);
    scene.add(fill);
    const rim = new THREE.PointLight(0x6366f1, 0.4, 20);
    rim.position.set(0, 4, -4);
    scene.add(rim);

    const spacing = 2.3;
    const startX = -((arr.length - 1) * spacing) / 2;
    const cubes: THREE.Mesh[] = [];
    const targets: { y: number; scale: number; colorHex: string; fx: string; x?: number; fxStart?: number }[] = [];

    arr.forEach((num, i) => {
      const geometry = new THREE.SphereGeometry(1, 48, 48);
      const baseColor = BALL_PALETTE[i % BALL_PALETTE.length];
      const tex = makePoolBallTexture(String(num), baseColor);
      const material = new THREE.MeshPhysicalMaterial({
        map: tex,
        metalness: 0.05,
        roughness: 0.1,
        clearcoat: 1,
        clearcoatRoughness: 0.06,
      });
      const cube = new THREE.Mesh(geometry, material);
      const posX = startX + i * spacing;
      cube.position.set(posX, 0, 0);
      cube.userData.baseX = posX;
      scene.add(cube);
      cubes.push(cube);
      const ix = new THREE.Sprite(new THREE.SpriteMaterial({ map: makeIndexTexture(i), transparent: true }));
      ix.scale.set(1.1, 1.1, 1);
      ix.position.set(posX, -1.9, 0);
      scene.add(ix);
      targets.push({ y: 0, scale: 1, colorHex: baseColor, fx: 'none' });
    });

    cubesRef.current = cubes;

    const targetBall = new THREE.Mesh(
      new THREE.SphereGeometry(1, 48, 48),
      new THREE.MeshPhysicalMaterial({
        map: makePoolBallTexture(String(target), '#4f46e5'),
        metalness: 0.05, roughness: 0.1, clearcoat: 1, clearcoatRoughness: 0.06,
      })
    );
    targetBall.position.set(TARGET_X, STAGE_Y, 0);
    scene.add(targetBall);

    const signTex = { plain: makeEqualsTexture('plain'), slash: makeEqualsTexture('slash'), ok: makeEqualsTexture('ok') };
    const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: signTex.plain, transparent: true }));
    sprite.scale.set(3.4, 3.4, 1);
    sprite.position.set((STAGE_X + TARGET_X) / 2, STAGE_Y, 0.5);
    sprite.visible = false;
    scene.add(sprite);
    signRef.current = { sprite, tex: signTex };
    targetsRef.current = targets;

    let frameId: number;
    const animate = () => {
      frameId = requestAnimationFrame(animate);
      const lerpAmt = Math.min(0.6, 0.12 * speedRef.current);
      cubes.forEach((cube, i) => {
        const t = targetsRef.current[i];
        if (!t) return;
        cube.position.y += (t.y - cube.position.y) * lerpAmt;
        const now = performance.now() / 1000;
        const bx = (t.x !== undefined ? t.x : cube.userData.baseX) as number;
        let dx = 0;
        if (t.fx === 'deny' && performance.now() - (t.fxStart ?? 0) > 500 / speedRef.current) dx = Math.sin(now * 38) * 0.32;   // quick left-right-left shake
        else if (t.fx === 'sway') dx = Math.sin(now * 4) * 0.6; // slow happy sway
        cube.position.x += (bx + dx - cube.position.x) * 0.35;
        const nextScale = cube.scale.x + (t.scale - cube.scale.x) * lerpAmt;
        cube.scale.setScalar(nextScale);
      });
      renderer.render(scene, camera);
    };
    animate();

    const handleResize = () => {
      const w = mount.clientWidth;
      height = calcH(w);
      mount.style.height = height + 'px';
      fitCamera(w, height);
      camera.aspect = w / height;
      camera.updateProjectionMatrix();
      renderer.setSize(w, height);
    };
    window.addEventListener('resize', handleResize);

    return () => {
      cancelAnimationFrame(frameId);
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
      scene.traverse((obj) => {
        if ((obj as THREE.Mesh).geometry) (obj as THREE.Mesh).geometry.dispose();
      });
      if (mount.contains(renderer.domElement)) mount.removeChild(renderer.domElement);
    };
  }, [arr]);

  // Push new targets whenever phase/index changes; the render loop lerps toward them
  useEffect(() => {
    const targets = targetsRef.current;
    const cubes = cubesRef.current;

    arr.forEach((num, i) => {
      const isCurrent = i === currentIndex && phase !== 'reset';
      const isPast = i < currentIndex && phase !== 'reset';

      let y = 0;
      let scale = 1;
      let colorHex = BALL_PALETTE[i % BALL_PALETTE.length];
      let fx = 'none';

      if (isCurrent) {
        if (phase === 'rise' || phase === 'compare') {
          y = STAGE_Y;
          colorHex = PHASE_COLORS.active;
        } else if (phase === 'correct' || phase === 'done') {
          y = STAGE_Y;
          colorHex = PHASE_COLORS.correct;
          fx = 'sway';
        } else if (phase === 'wrong') {
          y = STAGE_Y;
          scale = 1.35;
          colorHex = PHASE_COLORS.wrong;
          fx = 'deny';
        } else if (phase === 'lower') {
          y = 0;
          scale = 1;
          colorHex = BALL_PALETTE[i % BALL_PALETTE.length];
        }
      } else if (isPast) {
        colorHex = BALL_PALETTE[i % BALL_PALETTE.length];
      }

      if (targets[i]) {
        targets[i].y = y;
        targets[i].scale = scale;
        if (targets[i].fx !== fx) targets[i].fxStart = performance.now();
        targets[i].fx = fx;
        targets[i].x = isCurrent && phase !== 'lower' ? STAGE_X : undefined;
        if (targets[i].colorHex !== colorHex) {
          targets[i].colorHex = colorHex;
          const mesh = cubes[i];
          if (mesh) {
            const mat = mesh.material as THREE.MeshPhysicalMaterial;
            mat.map?.dispose();
            mat.map = makePoolBallTexture(String(num), colorHex);
            mat.needsUpdate = true;
          }
        }
      }
    });
  const sg = signRef.current;
    if (sg) {
      sg.sprite.visible = ['rise', 'compare', 'correct', 'wrong', 'done'].includes(phase);
      const key = phase === 'wrong' ? 'slash' : phase === 'correct' || phase === 'done' ? 'ok' : 'plain';
      const m = sg.sprite.material as THREE.SpriteMaterial;
      m.map = sg.tex[key];
      m.needsUpdate = true;
    }
  }, [currentIndex, phase, arr]);

  const targetBoxState = isWrong ? 'wrong' : isSettled ? 'correct' : 'idle';
  const targetBoxClasses =
    targetBoxState === 'correct'
      ? 'bg-emerald-500 border-emerald-300 text-white'
      : targetBoxState === 'wrong'
      ? 'bg-red-500 border-red-300 text-white'
      : 'bg-indigo-600 border-indigo-300 text-white';

  return (
    <div className="relative overflow-hidden rounded-xl border-2 border-slate-200 bg-white p-4 shadow-md flex flex-col items-center justify-center gap-2">

      <div className="text-center text-xs sm:text-sm font-bold text-indigo-600 min-h-[2.5rem] flex items-center justify-center px-2">
        {message}
      </div>
      <div ref={mountRef} className="w-full" style={{ minHeight: 200 }} />
      <div className="flex flex-wrap items-center justify-center gap-2">
        <SearchControls playing={playing} setPlaying={setPlaying} speed={speed} setSpeed={setSpeed} onRestart={() => { setCurrentIndex(0); setPhase('rise'); setPlaying(true); }} />
      </div>
      {isSettled && (
        <div className="pointer-events-none absolute inset-0 z-20 flex items-center justify-center bg-slate-900/25">
          <style>{`
            @keyframes lsRipple { 0% { transform: scale(0.6); opacity: 0.55; } 100% { transform: scale(2.4); opacity: 0; } }
            @keyframes lsPop { 0% { transform: scale(0.7); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
            @keyframes lsTick { to { stroke-dashoffset: 0; } }
          `}</style>
          <div
            className="flex flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-white px-5 py-4 sm:px-8 sm:py-6 shadow-2xl"
            style={{ animation: 'lsPop 0.35s ease-out both' }}
          >
            <div className="relative flex h-20 w-20 items-center justify-center">
              {[0, 0.5, 1].map((d) => (
                <span
                  key={d}
                  className="absolute inset-0 rounded-full bg-emerald-400"
                  style={{ animation: `lsRipple 1.6s ease-out ${d}s infinite` }}
                />
              ))}
              <div className="relative flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500 shadow-lg">
                <svg viewBox="0 0 24 24" className="h-9 w-9" fill="none" stroke="white" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M5 12.5l4.5 4.5L19 7.5" style={{ strokeDasharray: 24, strokeDashoffset: 24, animation: 'lsTick 0.4s ease-out 0.25s forwards' }} />
                </svg>
              </div>
            </div>
            <div className="text-center">
              <div className="text-base font-extrabold text-slate-900 sm:text-lg">Ball found by linear search</div>
              <div className="text-xs font-semibold text-slate-500">{target} found at index {currentIndex}</div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

// ──────────────────────────────────────────────────────────────────────────────
// MAIN COMPONENT
// ──────────────────────────────────────────────────────────────────────────────
function makeMiddleLabelTexture(label: string): THREE.CanvasTexture {
  const c = document.createElement('canvas');
  c.width = 512;
  c.height = 256;
  const ctx = c.getContext('2d')!;
  // arrow pointing up at the ball
  ctx.fillStyle = '#f59e0b';
  ctx.beginPath();
  ctx.moveTo(256, 6);
  ctx.lineTo(316, 86);
  ctx.lineTo(276, 86);
  ctx.lineTo(276, 130);
  ctx.lineTo(236, 130);
  ctx.lineTo(236, 86);
  ctx.lineTo(196, 86);
  ctx.closePath();
  ctx.fill();
  // label pill
  ctx.font = '800 38px sans-serif';
  const w = ctx.measureText(label).width + 48;
  ctx.fillStyle = '#0f172a';
  ctx.beginPath();
  ctx.roundRect(256 - w / 2, 150, w, 70, 18);
  ctx.fill();
  ctx.fillStyle = '#fde68a';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(label, 256, 186);
  const tex = new THREE.CanvasTexture(c);
  tex.needsUpdate = true;
  return tex;
}

const BINARY_DEMO_ARRAY = [2, 5, 8, 12, 15, 19, 23, 28, 31, 36, 40, 44, 49, 53, 57, 61, 66, 70, 74, 79, 83, 88, 92, 97];
const BINARY_DEMO_TARGET = 61;
const BS_MAX = 24;
// balls grow and spread out as fewer remain
function bsLayout(n: number) {
  const sc = Math.min(1, 0.55 * Math.sqrt(BS_MAX / Math.max(n, 1)));
  return { sc, gap: sc * 2.2 };
}

const BinarySearchAnimation: React.FC = () => {
  const arr = BINARY_DEMO_ARRAY;
  const target = BINARY_DEMO_TARGET;

  const [range, setRange] = useState({ lo: 0, hi: arr.length - 1 });
  const [phase, setPhase] = useState<SearchPhase>('highlight');
  const [playing, setPlaying] = useState(true);
  const [speed, setSpeed] = useState(1);
  const speedRef = useRef(1);
  speedRef.current = speed;
  const mid = Math.floor((range.lo + range.hi) / 2);

  const mountRef = useRef<HTMLDivElement>(null);
  const ballsRef = useRef<THREE.Mesh[]>([]);
  const targetsRef = useRef<{ y: number; scale: number; opacity: number; colorHex: string; fx: string; x?: number; fxStart?: number }[]>([]);
  const signRef = useRef<{ sprite: THREE.Sprite; tex: Record<string, THREE.CanvasTexture> } | null>(null);
  const arrowRef = useRef<THREE.Sprite | null>(null);

  // One step at a time:
  // highlight (x2) -> rise -> compare -> wrong (slash, then shake) -> remove half -> lower ball -> recentre -> highlight ...
  useEffect(() => {
    if (!playing) return;
    const tmo = (fn: () => void, ms: number) => setTimeout(fn, ms / speed);
    let t: ReturnType<typeof setTimeout>;
    const v = arr[mid];
    const nr = v < target ? { lo: mid + 1, hi: range.hi } : { lo: range.lo, hi: mid - 1 };
    if (phase === 'highlight') {
      t = tmo(() => setPhase('rise'), 1500);
    } else if (phase === 'rise') {
      t = tmo(() => setPhase('compare'), 900);
    } else if (phase === 'compare') {
      t = tmo(() => setPhase(v === target ? 'correct' : 'wrong'), 800);
    } else if (phase === 'correct') {
      t = tmo(() => setPhase('done'), 1400);
    } else if (phase === 'wrong') {
      t = tmo(() => setPhase('remove'), 1800);
    } else if (phase === 'remove') {
      t = tmo(() => setPhase('lower'), 1100);
    } else if (phase === 'lower') {
      t = tmo(() => {
        setRange(nr);
        setPhase('recentre');
      }, 900);
    } else if (phase === 'recentre') {
      t = tmo(() => setPhase('highlight'), 1200);
    } else if (phase === 'done') {
      t = tmo(() => setPhase('reset'), 1600);
    } else if (phase === 'reset') {
      t = tmo(() => {
        setRange({ lo: 0, hi: arr.length - 1 });
        setPhase('highlight');
      }, 800);
    }
    return () => clearTimeout(t);
  }, [phase, mid, range, arr, target, playing, speed]);

  const isSettled = phase === 'correct' || phase === 'done';

  let message = '';
  if (phase === 'reset') message = 'Restarting search…';
  else if (isSettled) message = `Found ${target} at index ${mid}!`;
  else if (phase === 'highlight') message = `The middle item is at index ${mid}`;
  else if (phase === 'rise') message = 'Lift the middle ball to test it';
  else if (phase === 'compare') message = `Is ${arr[mid]} equal to ${target}?`;
  else if (phase === 'wrong') message = `${arr[mid]} ≠ ${target}, not a match`;
  else if (phase === 'remove')
    message = arr[mid] < target
      ? `${arr[mid]} is too small, so remove the left half`
      : `${arr[mid]} is too big, so remove the right half`;
  else if (phase === 'lower') message = 'Put the ball back';
  else message = 'Move the remaining balls to the centre';

  // Scene setup
  useEffect(() => {
    const mount = mountRef.current;
    if (!mount) return;
    const width = mount.clientWidth;
    const calcH = (w: number) => Math.round(Math.min(400, Math.max(200, w * 0.5)));
    let height = calcH(width);
    mount.style.height = height + 'px';

    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#ffffff');
    const camera = new THREE.PerspectiveCamera(22, width / height, 0.1, 200);
    const fitCamera = (w: number) => {
      const z = Math.max(32, 31 / (2 * Math.tan((11 * Math.PI) / 180) * (w / height)));
      camera.position.set(0, z * 0.36, z);
      camera.lookAt(0, 2.0, 0);
    };
    fitCamera(width);
    let lastW = width;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    mount.innerHTML = '';
    mount.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const key = new THREE.DirectionalLight(0xffffff, 0.9);
    key.position.set(4, 6, 6);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xffffff, 0.35);
    fill.position.set(-5, 3, 2);
    scene.add(fill);

    const spacing = 2.3;
    const startX = -((arr.length - 1) * spacing) / 2;
    const balls: THREE.Mesh[] = [];
    const targets: { y: number; scale: number; opacity: number; colorHex: string; fx: string; x?: number; fxStart?: number }[] = [];

    arr.forEach((num, i) => {
      const baseColor = BALL_PALETTE[i % BALL_PALETTE.length];
      const material = new THREE.MeshPhysicalMaterial({
        map: makePoolBallTexture(String(num), baseColor),
        metalness: 0.05, roughness: 0.1, clearcoat: 1, clearcoatRoughness: 0.06,
        transparent: true, opacity: 1,
      });
      const ball = new THREE.Mesh(new THREE.SphereGeometry(1, 48, 48), material);
      const posX = startX + i * spacing;
      ball.position.set(posX, 0, 0);
      ball.userData.baseX = posX;
      scene.add(ball);
      balls.push(ball);
      targets.push({ y: 0, scale: 1, opacity: 1, colorHex: baseColor, fx: 'none' });
    });
    ballsRef.current = balls;
    targetsRef.current = targets;

    const targetBall = new THREE.Mesh(
      new THREE.SphereGeometry(1, 48, 48),
      new THREE.MeshPhysicalMaterial({
        map: makePoolBallTexture(String(target), '#4f46e5'),
        metalness: 0.05, roughness: 0.1, clearcoat: 1, clearcoatRoughness: 0.06,
      })
    );
    targetBall.position.set(TARGET_X, STAGE_Y, 0);
    scene.add(targetBall);

    const signTex = { plain: makeEqualsTexture('plain'), slash: makeEqualsTexture('slash'), ok: makeEqualsTexture('ok') };
    const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: signTex.plain, transparent: true }));
    sprite.scale.set(3.4, 3.4, 1);
    sprite.position.set((STAGE_X + TARGET_X) / 2, STAGE_Y, 0.5);
    sprite.visible = false;
    scene.add(sprite);
    signRef.current = { sprite, tex: signTex };

    const arrow = new THREE.Sprite(new THREE.SpriteMaterial({ map: makeMiddleLabelTexture('This is the middle'), transparent: true }));
    arrow.scale.set(7, 3.5, 1);
    arrow.position.set(0, -2.5, 1);
    arrow.visible = false;
    arrow.userData.label = 'This is the middle';
    scene.add(arrow);
    arrowRef.current = arrow;

    let frameId: number;
    const animate = () => {
      frameId = requestAnimationFrame(animate);
      const now = performance.now() / 1000;
      const kk = Math.min(0.6, 0.12 * speedRef.current);
      balls.forEach((b, i) => {
        const t = targetsRef.current[i];
        if (!t) return;
        b.position.y += (t.y - b.position.y) * kk;
        const pulse = t.fx === 'pulse' ? 1 + 0.4 * Math.abs(Math.sin(((performance.now() - (t.fxStart ?? 0)) / 1400) * Math.PI * 2)) : 1;
        b.scale.setScalar(b.scale.x + (t.scale * pulse - b.scale.x) * 0.2);
        const bx = (t.x !== undefined ? t.x : b.userData.baseX) as number;
        let dx = 0;
        if (t.fx === 'deny' && performance.now() - (t.fxStart ?? 0) > 500 / speedRef.current) dx = Math.sin(now * 38) * 0.32;
        else if (t.fx === 'sway') dx = Math.sin(now * 4) * 0.6;
        b.position.x += (bx + dx - b.position.x) * 0.35;
        const m = b.material as THREE.MeshPhysicalMaterial;
        m.opacity += (t.opacity - m.opacity) * kk;
        b.visible = m.opacity > 0.03;
      });
      if (mount.clientWidth !== lastW) {
        lastW = mount.clientWidth;
        height = calcH(lastW);
        mount.style.height = height + 'px';
        fitCamera(lastW);
        camera.aspect = lastW / height;
        camera.updateProjectionMatrix();
        renderer.setSize(lastW, height);
      }
      renderer.render(scene, camera);
    };
    animate();

    const handleResize = () => {
      const w = mount.clientWidth;
      camera.aspect = w / height;
      camera.updateProjectionMatrix();
      renderer.setSize(w, height);
    };
    window.addEventListener('resize', handleResize);

    return () => {
      cancelAnimationFrame(frameId);
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
      scene.traverse((obj) => {
        if ((obj as THREE.Mesh).geometry) (obj as THREE.Mesh).geometry.dispose();
      });
      if (mount.contains(renderer.domElement)) mount.removeChild(renderer.domElement);
    };
  }, [arr, target]);

  // Push new targets whenever the round or phase changes
  useEffect(() => {
    const targets = targetsRef.current;
    const balls = ballsRef.current;
    const vMid = arr[mid];
    const nr = vMid < target ? { lo: mid + 1, hi: range.hi } : { lo: range.lo, hi: mid - 1 };
    const cutting = phase === 'remove' || phase === 'lower';
    const vis = cutting ? nr : range;
    const { sc, gap } = bsLayout(range.hi - range.lo + 1);
    const centre = (range.lo + range.hi) / 2;
    const raised = ['rise', 'compare', 'wrong', 'remove', 'correct', 'done'].includes(phase);

    arr.forEach((num, i) => {
      const isMid = i === mid;
      const shown = (i >= vis.lo && i <= vis.hi) || (isMid && cutting);

      let y = 0, scale = shown ? sc : 0.01, opacity = shown ? 1 : 0, fx = 'none';
      let colorHex = BALL_PALETTE[i % BALL_PALETTE.length];

      if (isMid) {
        if (raised) { y = STAGE_Y; scale = 1; }
        if (phase === 'highlight') { colorHex = PHASE_COLORS.active; fx = 'pulse'; }
        else if (phase === 'rise' || phase === 'compare') colorHex = PHASE_COLORS.active;
        else if (phase === 'correct' || phase === 'done') { colorHex = PHASE_COLORS.correct; fx = 'sway'; }
        else if (phase === 'wrong') { scale = 1.35; colorHex = PHASE_COLORS.wrong; fx = 'deny'; }
        else if (phase === 'remove') { scale = 1.35; colorHex = PHASE_COLORS.wrong; }
      }

      const tg = targets[i];
      if (tg) {
        tg.y = y;
        tg.scale = scale;
        tg.opacity = opacity;
        if (tg.fx !== fx) tg.fxStart = performance.now();
        tg.fx = fx;
        tg.x = isMid && raised ? STAGE_X : (i - centre) * gap;
        if (tg.colorHex !== colorHex) {
          tg.colorHex = colorHex;
          const mesh = balls[i];
          if (mesh) {
            const mat = mesh.material as THREE.MeshPhysicalMaterial;
            mat.map?.dispose();
            mat.map = makePoolBallTexture(String(num), colorHex);
            mat.needsUpdate = true;
          }
        }
      }
    });

    const ar = arrowRef.current;
    if (ar) {
      ar.visible = phase === 'highlight';
      const label = range.lo === 0 && range.hi === arr.length - 1 ? 'This is the middle' : 'This is the new middle';
      if (ar.userData.label !== label) {
        ar.userData.label = label;
        const am = ar.material as THREE.SpriteMaterial;
        am.map?.dispose();
        am.map = makeMiddleLabelTexture(label);
        am.needsUpdate = true;
      }
      ar.position.set((mid - centre) * gap, -sc - 1.9, 1);
    }

    const sg = signRef.current;
    if (sg) {
      sg.sprite.visible = ['rise', 'compare', 'wrong', 'remove', 'correct', 'done'].includes(phase);
      const k = phase === 'wrong' || phase === 'remove' ? 'slash' : phase === 'correct' || phase === 'done' ? 'ok' : 'plain';
      const m = sg.sprite.material as THREE.SpriteMaterial;
      m.map = sg.tex[k];
      m.needsUpdate = true;
    }
  }, [range, phase, mid, arr]);

  return (
    <div className="relative overflow-hidden rounded-xl border-2 border-slate-200 bg-white p-4 shadow-md flex flex-col items-center justify-center gap-2">
      <div className="text-center text-xs sm:text-sm font-bold text-indigo-600 min-h-[2.5rem] flex items-center justify-center px-2">
        {message}
      </div>
      <div className="flex flex-wrap justify-center gap-2 font-mono text-[11px] font-bold text-slate-600 sm:text-xs">
        <span className="rounded bg-slate-100 px-2 py-1">low = {range.lo}</span>
        <span className="rounded bg-amber-100 px-2 py-1">middle = {mid}</span>
        <span className="rounded bg-slate-100 px-2 py-1">high = {range.hi}</span>
      </div>
      <div ref={mountRef} className="w-full" style={{ minHeight: 200 }} />
      <div className="flex flex-wrap items-center justify-center gap-2">
        <SearchControls playing={playing} setPlaying={setPlaying} speed={speed} setSpeed={setSpeed} onRestart={() => { setRange({ lo: 0, hi: arr.length - 1 }); setPhase('highlight'); setPlaying(true); }} />
      </div>
      {isSettled && (
        <div className="pointer-events-none absolute inset-0 z-20 flex items-center justify-center bg-slate-900/25">
          <style>{`
            @keyframes bsRipple { 0% { transform: scale(0.6); opacity: 0.55; } 100% { transform: scale(2.4); opacity: 0; } }
            @keyframes bsPop { 0% { transform: scale(0.7); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
            @keyframes bsTick { to { stroke-dashoffset: 0; } }
          `}</style>
          <div className="flex flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-white px-5 py-4 sm:px-8 sm:py-6 shadow-2xl" style={{ animation: 'bsPop 0.35s ease-out both' }}>
            <div className="relative flex h-20 w-20 items-center justify-center">
              {[0, 0.5, 1].map((d) => (
                <span key={d} className="absolute inset-0 rounded-full bg-emerald-400" style={{ animation: `bsRipple 1.6s ease-out ${d}s infinite` }} />
              ))}
              <div className="relative flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500 shadow-lg">
                <svg viewBox="0 0 24 24" className="h-9 w-9" fill="none" stroke="white" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M5 12.5l4.5 4.5L19 7.5" style={{ strokeDasharray: 24, strokeDashoffset: 24, animation: 'bsTick 0.4s ease-out 0.25s forwards' }} />
                </svg>
              </div>
            </div>
            <div className="text-center">
              <div className="text-base font-extrabold text-slate-900 sm:text-lg">Ball found by binary search</div>
              <div className="text-xs font-semibold text-slate-500">{target} found at index {mid}</div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

// ──────────────────────────────────────────────────────────────────────────────
// SORTING: FRAME BUILDER + ANIMATION + LESSON CONTAINER
// ──────────────────────────────────────────────────────────────────────────────
type SortMark = { pos: number; text: string; tone: 'info' | 'swap' | 'no' | 'ok' };
type SortFrame = { vals: number[]; up: number[]; marks: SortMark[]; done: number[]; msg: string; dur: number };
const SORT_DEMO = [7, 3, 8, 1, 5, 2, 6, 4];
const SORT_ORANGE = '#fb923c';
const TONE_BG: Record<string, string> = { info: '#f59e0b', swap: '#ea580c', no: '#dc2626', ok: '#059669' };
const TONE_FG: Record<string, string> = { info: '#0f172a', swap: '#ffffff', no: '#ffffff', ok: '#ffffff' };
const TONE_BALL: Record<string, string> = { info: '#fbbf24', swap: SORT_ORANGE, no: '#f87171', ok: '#34d399' };

// pill with a label and an arrow pointing DOWN at the ball
function makePointerTexture(text: string, tone: string): THREE.CanvasTexture {
  const c = document.createElement('canvas');
  c.width = 256;
  c.height = 256;
  const ctx = c.getContext('2d')!;
  ctx.fillStyle = TONE_BG[tone];
  ctx.beginPath();
  ctx.roundRect(8, 8, 240, 76, 22);
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(108, 84); ctx.lineTo(148, 84); ctx.lineTo(148, 150);
  ctx.lineTo(184, 150); ctx.lineTo(128, 248); ctx.lineTo(72, 150); ctx.lineTo(108, 150);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = TONE_FG[tone];
  ctx.font = '800 40px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(text, 128, 48);
  const tex = new THREE.CanvasTexture(c);
  tex.needsUpdate = true;
  return tex;
}

function buildSortFrames(algo: string): SortFrame[] {
  const a = [...SORT_DEMO];
  const n = a.length;
  const done: number[] = [];
  const frames: SortFrame[] = [];
  const push = (up: number[], marks: SortMark[], msg: string, dur: number) =>
    frames.push({ vals: [...a], up, marks, done: [...done], msg, dur });
  const swap = (i: number, j: number) => { const t = a[i]; a[i] = a[j]; a[j] = t; };
  const words = (i: number, j: number): [string, string] =>
    a[i] > a[j] ? ['bigger', 'smaller'] : a[i] < a[j] ? ['smaller', 'bigger'] : ['equal', 'equal'];

  // lift one, lift the other, show WHY, (optionally act), put back
  const test = (i: number, j: number, want: boolean, why: string, act?: () => void, after?: string) => {
    push([i], [{ pos: i, text: 'first', tone: 'info' }], `Lift ${a[i]}`, 900);
    push([i, j], [{ pos: i, text: 'first', tone: 'info' }, { pos: j, text: 'second', tone: 'info' }], `Lift ${a[j]} to compare`, 900);
    const [wi, wj] = words(i, j);
    const tone = want ? 'swap' : 'no';
    push([i, j], [{ pos: i, text: wi, tone }, { pos: j, text: wj, tone }], why, 2000);
    if (act) {
      act();
      push([i, j], [{ pos: i, text: 'moved', tone: 'swap' }, { pos: j, text: 'moved', tone: 'swap' }], after || 'Swapped', 1300);
    }
    push([], [], 'Put them back', 700);
  };
  const move = (i: number, j: number, why: string) => {
    push([i, j], [{ pos: i, text: 'swap', tone: 'swap' }, { pos: j, text: 'swap', tone: 'swap' }], why, 1500);
    swap(i, j);
    push([i, j], [{ pos: i, text: 'moved', tone: 'swap' }, { pos: j, text: 'moved', tone: 'swap' }], 'Swapped', 1300);
    push([], [], 'Put them back', 700);
  };

  push([], [], 'Unsorted list. Sort smallest to biggest.', 1500);

  if (algo === 'bubble') {
    for (let i = 0; i < n - 1; i++) {
      let sw = false;
      for (let j = 0; j < n - 1 - i; j++) {
        const want = a[j] > a[j + 1];
        test(j, j + 1, want,
          want ? `${a[j]} > ${a[j + 1]}: wrong order, swap` : `${a[j]} ≤ ${a[j + 1]}: right order, keep`,
          want ? () => swap(j, j + 1) : undefined, 'Swapped');
        if (want) sw = true;
      }
      done.push(n - 1 - i);
      push([], [], `${a[n - 1 - i]} is in its final place`, 1200);
      if (!sw) break;
    }
  } else if (algo === 'selection') {
    for (let i = 0; i < n - 1; i++) {
      let m = i;
      for (let j = i + 1; j < n; j++) {
        const want = a[j] < a[m];
        test(m, j, want,
          want ? `${a[j]} < ${a[m]}: new smallest` : `${a[j]} ≥ ${a[m]}: not smaller, skip`);
        if (want) m = j;
      }
      if (m !== i) move(i, m, `Smallest (${a[m]}) goes to place ${i}`);
      done.push(i);
      push([], [], `${a[i]} is in its final place`, 1200);
    }
  } else if (algo === 'insertion') {
    done.push(0);
    for (let i = 1; i < n; i++) {
      let j = i;
      while (j > 0) {
        const want = a[j - 1] > a[j];
        const k = j;
        test(j - 1, j, want,
          want ? `${a[j - 1]} > ${a[j]}: wrong order, shift left` : `${a[j - 1]} ≤ ${a[j]}: right order, stop`,
          want ? () => swap(k - 1, k) : undefined, 'Shifted left');
        if (want) j--; else break;
      }
      done.push(i);
      push([], [], `Sorted part is now ${i + 1} items long`, 1100);
    }
  } else if (algo === 'shell') {
    for (let gap = Math.floor(n / 2); gap > 0; gap = Math.floor(gap / 2)) {
      for (let i = gap; i < n; i++) {
        let j = i;
        while (j >= gap) {
          const want = a[j - gap] > a[j];
          const k = j;
          test(j - gap, j, want,
            want ? `Gap ${gap}: ${a[j - gap]} > ${a[j]}, swap` : `Gap ${gap}: ${a[j - gap]} ≤ ${a[j]}, keep`,
            want ? () => swap(k - gap, k) : undefined, 'Swapped');
          if (want) j -= gap; else break;
        }
      }
      push([], [], `Gap ${gap} pass done`, 1100);
    }
  } else if (algo === 'merge') {
    const ms = (l: number, r: number) => {
      if (l >= r) return;
      const m = Math.floor((l + r) / 2);
      ms(l, m);
      ms(m + 1, r);
      let i = l, mid = m, j = m + 1;
      while (i <= mid && j <= r) {
        const want = a[j] < a[i];
        const ii = i, jj = j;
        test(i, j, want,
          want ? `${a[j]} < ${a[i]}: ${a[j]} goes first` : `${a[i]} ≤ ${a[j]}: ${a[i]} stays first`,
          want ? () => { const v = a[jj]; for (let k = jj; k > ii; k--) a[k] = a[k - 1]; a[ii] = v; } : undefined,
          'Moved to the front');
        if (!want) i++;
        else { i++; mid++; j++; }
      }
      push([], [], `Places ${l} to ${r} are merged`, 1100);
    };
    ms(0, n - 1);
  } else if (algo === 'heap') {
    const sift = (start: number, size: number) => {
      let i = start;
      while (true) {
        let lg = i;
        const l = 2 * i + 1, r = 2 * i + 2;
        if (l < size) {
          const want = a[l] > a[lg];
          test(lg, l, want, want ? `${a[l]} > ${a[lg]}: child is bigger` : `${a[l]} ≤ ${a[lg]}: parent is bigger`);
          if (want) lg = l;
        }
        if (r < size) {
          const want = a[r] > a[lg];
          test(lg, r, want, want ? `${a[r]} > ${a[lg]}: child is bigger` : `${a[r]} ≤ ${a[lg]}: parent is bigger`);
          if (want) lg = r;
        }
        if (lg === i) break;
        move(i, lg, 'Bigger child moves up');
        i = lg;
      }
    };
    for (let i = Math.floor(n / 2) - 1; i >= 0; i--) sift(i, n);
    push([], [], `Heap built. Biggest (${a[0]}) is on top`, 1400);
    for (let e = n - 1; e > 0; e--) {
      move(0, e, `Biggest (${a[0]}) goes to the end`);
      done.push(e);
      push([], [], `${a[e]} is in its final place`, 1200);
      sift(0, e);
    }
  }

  for (let k = 0; k < n; k++) if (!done.includes(k)) done.push(k);
  push([], [], 'The list is sorted!', 2600);
  return frames;
}

const SortAnimation: React.FC<{ algo: string }> = ({ algo }) => {
  const frames = React.useMemo(() => buildSortFrames(algo), [algo]);
  const [idx, setIdx] = useState(0);
  const [playing, setPlaying] = useState(true);
  const [speed, setSpeed] = useState(1);
  const speedRef = useRef(1);
  speedRef.current = speed;
  const frame = frames[idx];

  const mountRef = useRef<HTMLDivElement>(null);
  const ballsRef = useRef<THREE.Mesh[]>([]);
  const labelsRef = useRef<THREE.Sprite[]>([]);
  const texRef = useRef<Record<string, THREE.CanvasTexture>>({});
  const targetsRef = useRef<{ x: number; y: number; colorHex: string }[]>([]);

  useEffect(() => {
    if (!playing) return;
    const t = setTimeout(() => setIdx((i) => (i === frames.length - 1 ? 0 : i + 1)), frame.dur / speed);
    return () => clearTimeout(t);
  }, [idx, frames.length, frame.dur, playing, speed]);

  useEffect(() => {
    const mount = mountRef.current;
    if (!mount) return;
    const width = mount.clientWidth;
    const height = 320;
    const spacing = 2.3;
    const n = SORT_DEMO.length;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#ffffff');
    const camera = new THREE.PerspectiveCamera(22, width / height, 0.1, 200);
    const fitCamera = (w: number) => {
      const z = Math.max(26, 21 / (2 * Math.tan((11 * Math.PI) / 180) * (w / height)));
      camera.position.set(0, z * 0.3, z);
      camera.lookAt(0, 2.2, 0);
    };
    fitCamera(width);
    let lastW = width;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    mount.innerHTML = '';
    mount.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const key = new THREE.DirectionalLight(0xffffff, 0.9);
    key.position.set(4, 6, 6);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xffffff, 0.35);
    fill.position.set(-5, 3, 2);
    scene.add(fill);

    const balls: THREE.Mesh[] = [];
    const targets: { x: number; y: number; colorHex: string }[] = [];
    SORT_DEMO.forEach((v, k) => {
      const color = BALL_PALETTE[k % BALL_PALETTE.length];
      const mat = new THREE.MeshPhysicalMaterial({
        map: makePoolBallTexture(String(v), color),
        metalness: 0.05, roughness: 0.1, clearcoat: 1, clearcoatRoughness: 0.06,
      });
      const ball = new THREE.Mesh(new THREE.SphereGeometry(1, 48, 48), mat);
      const x = (k - (n - 1) / 2) * spacing;
      ball.position.set(x, 0, 0);
      scene.add(ball);
      balls.push(ball);
      targets.push({ x, y: 0, colorHex: color });
    });
    ballsRef.current = balls;
    targetsRef.current = targets;

    const labels: THREE.Sprite[] = [0, 1].map(() => {
      const sp = new THREE.Sprite(new THREE.SpriteMaterial({ transparent: true, opacity: 0 }));
      sp.scale.set(2.2, 2.2, 1);
      sp.visible = false;
      sp.userData.o = 0;
      sp.position.set(0, 4.9, 1);
      scene.add(sp);
      return sp;
    });
    labelsRef.current = labels;

    let frameId: number;
    let lastT = performance.now();
    const animate = () => {
      frameId = requestAnimationFrame(animate);
      const nowMs = performance.now();
      const dt = Math.min(0.05, (nowMs - lastT) / 1000);
      lastT = nowMs;
      const kb = 1 - Math.exp(-dt * 7 * speedRef.current);   // balls: smooth glide
      const kl = 1 - Math.exp(-dt * 16 * speedRef.current);  // arrows: quick but smooth
      balls.forEach((b, k) => {
        const t = targetsRef.current[k];
        if (!t) return;
        const dx = t.x - b.position.x;
        b.position.x += dx * kb;
        b.userData.by = (b.userData.by ?? 0) + (t.y - (b.userData.by ?? 0)) * kb;
        const from = b.userData.fromX ?? t.x;
        const total = t.x - from;
        let arcY = 0, arcZ = 0;
        if (Math.abs(total) > 0.01 && Math.abs(dx) > 0.01) {
          const pr = Math.min(1, Math.max(0, 1 - dx / total));
          const dir = total > 0 ? 1 : -1;               // right = over, left = under
          const amp = Math.min(2.2, 0.7 + Math.abs(total) * 0.35);
          const bump = Math.sin(pr * Math.PI);
          arcY = dir * amp * bump;
          arcZ = dir * 1.0 * bump;
        }
        b.position.y = b.userData.by + arcY;
        b.position.z += (arcZ - b.position.z) * Math.min(1, kb * 2);
      });
      labels.forEach((sp) => {
        const m = sp.material as THREE.SpriteMaterial;
        m.opacity += ((sp.userData.o ?? 0) - m.opacity) * kl;
        sp.visible = m.opacity > 0.02;
        sp.position.x += ((sp.userData.tx ?? sp.position.x) - sp.position.x) * kl;
        const ty = 4.9 + Math.sin(nowMs / 330) * 0.08; // gentle bob
        sp.position.y += (ty - sp.position.y) * kl;
      });
      if (mount.clientWidth !== lastW) {
        lastW = mount.clientWidth;
        fitCamera(lastW);
        camera.aspect = lastW / height;
        camera.updateProjectionMatrix();
        renderer.setSize(lastW, height);
      }
      renderer.render(scene, camera);
    };
    animate();

    return () => {
      cancelAnimationFrame(frameId);
      renderer.dispose();
      scene.traverse((obj) => {
        if ((obj as THREE.Mesh).geometry) (obj as THREE.Mesh).geometry.dispose();
      });
      if (mount.contains(renderer.domElement)) mount.removeChild(renderer.domElement);
    };
  }, []);

  useEffect(() => {
    const n = SORT_DEMO.length;
    const spacing = 2.3;
    SORT_DEMO.forEach((v, k) => {
      const tg = targetsRef.current[k];
      const mesh = ballsRef.current[k];
      if (!tg || !mesh) return;
      const pos = frame.vals.indexOf(v);
      const mark = frame.marks.find((m) => m.pos === pos);
      let color = BALL_PALETTE[k % BALL_PALETTE.length];
      if (frame.done.includes(pos)) color = PHASE_COLORS.correct;
      if (mark) color = TONE_BALL[mark.tone];
      const nx = (pos - (n - 1) / 2) * spacing;
      if (Math.abs(nx - tg.x) > 0.01) mesh.userData.fromX = mesh.position.x;
      tg.x = nx;
      tg.y = frame.up.includes(pos) ? 2.6 : 0;
      if (tg.colorHex !== color) {
        tg.colorHex = color;
        const mat = mesh.material as THREE.MeshPhysicalMaterial;
        mat.map?.dispose();
        mat.map = makePoolBallTexture(String(v), color);
        mat.needsUpdate = true;
      }
    });

    labelsRef.current.forEach((sp, k) => {
      const mark = frame.marks[k];
      const m = sp.material as THREE.SpriteMaterial;
      if (!mark) { sp.userData.o = 0; return; }
      const key = `${mark.text}|${mark.tone}`;
      if (!texRef.current[key]) texRef.current[key] = makePointerTexture(mark.text, mark.tone);
      const tx = (mark.pos - (n - 1) / 2) * spacing;
      if (m.opacity < 0.05) { sp.position.x = tx; sp.position.y = 5.9; } // drop in from above
      sp.userData.tx = tx;
      sp.userData.o = 1;
      m.map = texRef.current[key];
      m.needsUpdate = true;
    });
  }, [frame]);

  return (
    <div className="rounded-xl border-2 border-slate-200 bg-white p-4 shadow-md flex flex-col items-center gap-2">
      <div className="text-center text-sm sm:text-base font-extrabold text-indigo-600 min-h-[2.5rem] flex items-center justify-center px-2">
        {frame.msg || '\u00A0'}
      </div>
      <div className="flex flex-wrap justify-center gap-2 text-[10px] font-bold text-slate-600 sm:text-xs">
        <span className="rounded bg-yellow-100 px-2 py-1">Yellow = lifted</span>
        <span className="rounded bg-orange-100 px-2 py-1">Orange = yes / swap</span>
        <span className="rounded bg-red-100 px-2 py-1">Red = rejected</span>
        <span className="rounded bg-emerald-100 px-2 py-1">Green = final place</span>
      </div>
      <div ref={mountRef} className="w-full" style={{ height: 320 }} />
      <div className="flex flex-wrap items-center justify-center gap-2">
        <button
          type="button"
          onClick={() => setPlaying((v) => !v)}
          className="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-bold text-white shadow-sm hover:bg-indigo-700"
        >
          {playing ? '⏸ Pause' : '▶ Play'}
        </button>
        <button
          type="button"
          onClick={() => { setIdx(0); setPlaying(true); }}
          className="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-50"
        >
          ↻ Restart
        </button>
        <div className="flex items-center gap-1 rounded-lg border border-slate-300 bg-white p-1">
          <span className="px-1 text-[10px] font-bold uppercase text-slate-400">Speed</span>
          {[0.5, 1, 2, 3].map((v) => (
            <button
              key={v}
              type="button"
              onClick={() => setSpeed(v)}
              className={`rounded-md px-2 py-1 text-xs font-bold ${speed === v ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100'}`}
            >
              {v}x
            </button>
          ))}
        </div>
      </div>
      <div className="text-[10px] font-semibold text-slate-400">Step {idx + 1} of {frames.length}</div>
    </div>
  );
};

type SortInfo = {
  id: string; title: string; intro: string; analogy: string; steps: string[];
  watch: string; example: string[]; remember: string[]; code: string; time: string; space: string;
};

const SORT_LESSONS: SortInfo[] = [
  {
    id: 'bubble', title: 'Bubble Sort',
    intro: 'Bubble sort looks at two neighbours at a time. If they are in the wrong order, it swaps them. It keeps walking along the list until nothing needs swapping.',
    analogy: 'Think of bubbles in a drink. The biggest bubble rises to the top first, then the next biggest, and so on. In the same way, the biggest number moves to the end after each pass.',
    steps: [
      'Start at the first item and compare it with the item next to it.',
      'If the left item is bigger, swap them. If not, leave them.',
      'Move one step to the right and compare again. Keep going to the end of the list.',
      'After one full pass, the biggest item is at the end. It is in its final place.',
      'Do the pass again, but stop one place earlier each time.',
      'If a whole pass makes no swaps, the list is sorted and you can stop.',
    ],
    watch: 'In the animation, two neighbours rise and turn yellow while they are compared. If they are in the wrong order they turn orange and swap places. When a ball reaches the end of the row it turns green, because it is in its final place.',
    example: [
      'List: 7, 3, 8, 1, 5, 2, 6, 4.',
      'Pass 1: 7 and 3 swap, 7 and 8 stay, 8 and 1 swap, and so on. The 8 bubbles all the way to the end.',
      'Pass 2: the 7 bubbles up to the second-last place.',
      'Each pass fixes one more item at the end, until the list is sorted.',
    ],
    remember: [
      'It is simple, but slow on big lists because it compares many pairs.',
      'Best case: a list that is already sorted needs only one pass, so O(n).',
      'Worst case: a list in reverse order, so O(n²).',
      'It is stable, which means equal items keep their order.',
    ],
    code: `void bubbleSort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        bool swapped = false;
        for (int j = 0; j < n - 1 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                int t = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = t;
                swapped = true;
            }
        }
        if (!swapped) break; // already sorted
    }
}`,
    time: 'Time: best O(n), worst O(n²)', space: 'Space: O(1)',
  },
  {
    id: 'selection', title: 'Selection Sort',
    intro: 'Selection sort finds the smallest item in the unsorted part of the list and puts it at the front. Then it repeats for the rest of the list.',
    analogy: 'Think of picking players for a team. You look at everyone, pick the shortest, and put them first in line. Then you look at everyone left, pick the shortest again, and put them second.',
    steps: [
      'Look at the whole unsorted part of the list and find the smallest item.',
      'Swap that smallest item with the first item of the unsorted part.',
      'That first place is now fixed. It is in its final place.',
      'Move the start of the unsorted part one step to the right.',
      'Repeat until only one item is left. It must already be in the right place.',
    ],
    watch: 'In the animation, the balls rise and turn yellow as they are compared to find the smallest. When the smallest is found it swaps into the front place, turns green, and stays there.',
    example: [
      'List: 7, 3, 8, 1, 5, 2, 6, 4.',
      'Round 1: the smallest is 1, so it swaps with 7 and goes to place 0.',
      'Round 2: the smallest of the rest is 2, so it goes to place 1.',
      'Keep going until every ball is green.',
    ],
    remember: [
      'It does very few swaps, at most one per round.',
      'It always does the same number of comparisons, even on a sorted list. That is why it is not adaptive.',
      'Best, average and worst case are all O(n²).',
      'It is not stable, because the swap can jump over equal items.',
    ],
    code: `void selectionSort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int minIndex = i;
        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[minIndex]) {
                minIndex = j;
            }
        }
        int t = arr[i];
        arr[i] = arr[minIndex];
        arr[minIndex] = t;
    }
}`,
    time: 'Time: always O(n²)', space: 'Space: O(1)',
  },
  {
    id: 'insertion', title: 'Insertion Sort',
    intro: 'Insertion sort builds a sorted list one item at a time. It takes the next item and slides it left until it sits in the right place among the items already sorted.',
    analogy: 'Think of holding playing cards. You pick up one card at a time and slide it into the right spot in the cards already in your hand.',
    steps: [
      'Treat the first item as a sorted list of one.',
      'Take the next item. This is the item you will insert.',
      'Compare it with the item on its left. If the left one is bigger, shift the item left.',
      'Keep shifting until the left item is smaller or you reach the start.',
      'Now the sorted part is one item longer.',
      'Repeat for every item until the whole list is sorted.',
    ],
    watch: 'In the animation, the green balls on the left are the sorted part. The next ball rises, is compared with its left neighbour, and slides left one place at a time until it fits.',
    example: [
      'List: 7, 3, 8, 1, 5, 2, 6, 4.',
      'Start with 7 as the sorted part. Take 3: it is smaller than 7, so it slides left. Sorted part: 3, 7.',
      'Take 8: it is bigger than 7, so it stays. Sorted part: 3, 7, 8.',
      'Take 1: it slides all the way to the front. And so on.',
    ],
    remember: [
      'It is fast on lists that are small or nearly sorted.',
      'Best case: an already sorted list needs only one check per item, so O(n).',
      'Worst case: a reverse list, so O(n²).',
      'It is stable and adaptive.',
    ],
    code: `void insertionSort(int arr[], int n) {
    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j]; // shift right
            j--;
        }
        arr[j + 1] = key;
    }
}`,
    time: 'Time: best O(n), worst O(n²)', space: 'Space: O(1)',
  },
  {
    id: 'shell', title: 'Shell Sort',
    intro: 'Shell sort is insertion sort with a clever start. It first compares items that are far apart, using a gap. Then it makes the gap smaller each round. The last round uses a gap of 1, which is normal insertion sort on a list that is already nearly sorted.',
    analogy: 'Think of tidying a messy shelf. First you move books that are very far from where they belong. Then you fix smaller mistakes. By the end, only tiny fixes are left.',
    steps: [
      'Pick a starting gap. A common choice is half the size of the list.',
      'Compare items that are one gap apart, and swap them if they are in the wrong order.',
      'Do this along the whole list, like insertion sort but jumping by the gap.',
      'Cut the gap in half.',
      'Repeat until the gap is 1. The last pass finishes the job.',
    ],
    watch: 'In the animation, the balls that rise together are one gap apart, not always neighbours. Watch the gap start big (4), then 2, then 1. Far-apart swaps early on mean fewer moves later.',
    example: [
      'List: 7, 3, 8, 1, 5, 2, 6, 4 (8 items).',
      'Gap 4: compare 7 with 5, 3 with 2, 8 with 6, 1 with 4. Swap the ones that are out of order.',
      'Gap 2: compare items two places apart.',
      'Gap 1: a normal insertion sort, but the list is already nearly sorted, so it is fast.',
    ],
    remember: [
      'It is faster than plain insertion sort because items travel far in one move.',
      'The speed depends on the gap sequence you choose. Average is about O(n^1.5).',
      'Worst case can still be O(n²).',
      'It is not stable, but it is adaptive.',
    ],
    code: `void shellSort(int arr[], int n) {
    for (int gap = n / 2; gap > 0; gap /= 2) {
        for (int i = gap; i < n; i++) {
            int temp = arr[i];
            int j = i;
            while (j >= gap && arr[j - gap] > temp) {
                arr[j] = arr[j - gap];
                j -= gap;
            }
            arr[j] = temp;
        }
    }
}`,
    time: 'Time: average about O(n^1.5), worst O(n²)', space: 'Space: O(1)',
  },
  {
    id: 'merge', title: 'Merge Sort',
    intro: 'Merge sort splits the list in half again and again until every piece has one item. A single item is already sorted. Then it merges the pieces back together in order.',
    analogy: 'Think of two sorted piles of exam papers. To join them into one sorted pile, you only look at the top paper of each pile and take the smaller one. Merge sort does that over and over.',
    steps: [
      'Split the list into a left half and a right half.',
      'Keep splitting each half until every piece has only one item.',
      'Merge two pieces at a time. Look at the first item of each and take the smaller.',
      'Keep taking the smaller item until both pieces are used up. Now you have one sorted piece.',
      'Merge bigger and bigger pieces until the whole list is one sorted list.',
    ],
    watch: 'In the animation, two balls rise to be compared, one from each half. When the right ball is smaller it moves in front and the others shift along. The animation moves balls inside the row to keep things easy to follow. The real code uses a second array.',
    example: [
      'List: 7, 3, 8, 1, 5, 2, 6, 4.',
      'Split down to single items, then merge pairs: (3, 7), (1, 8), (2, 5), (4, 6).',
      'Merge those: (1, 3, 7, 8) and (2, 4, 5, 6).',
      'Merge the last two: 1, 2, 3, 4, 5, 6, 7, 8.',
    ],
    remember: [
      'It is always O(n log n), even in the worst case. That is very reliable.',
      'It needs extra memory (O(n)) for the merging.',
      'It is stable, so equal items keep their order.',
      'It is not adaptive. A sorted list takes just as long.',
    ],
    code: `void merge(int arr[], int l, int m, int r) {
    int n1 = m - l + 1, n2 = r - m;
    int L[n1], R[n2];
    for (int i = 0; i < n1; i++) L[i] = arr[l + i];
    for (int j = 0; j < n2; j++) R[j] = arr[m + 1 + j];
    int i = 0, j = 0, k = l;
    while (i < n1 && j < n2) {
        if (L[i] <= R[j]) arr[k++] = L[i++];
        else arr[k++] = R[j++];
    }
    while (i < n1) arr[k++] = L[i++];
    while (j < n2) arr[k++] = R[j++];
}

void mergeSort(int arr[], int l, int r) {
    if (l >= r) return;
    int m = l + (r - l) / 2;
    mergeSort(arr, l, m);
    mergeSort(arr, m + 1, r);
    merge(arr, l, m, r);
}`,
    time: 'Time: always O(n log n)', space: 'Space: O(n)',
  },
  {
    id: 'heap', title: 'Heap Sort',
    intro: 'Heap sort first arranges the list into a max heap, where every parent is bigger than its children. That puts the biggest item at the top. Then it moves the biggest item to the end and repairs the heap, again and again.',
    analogy: 'Think of a knockout tournament where the strongest player always ends at the top. Take the champion out, let the others play again to find a new champion, and repeat.',
    steps: [
      'Build a max heap. Item 0 is the top. The children of item i are items 2i+1 and 2i+2.',
      'The biggest item is now at the top (place 0).',
      'Swap the top with the last item. The biggest is now in its final place at the end.',
      'Shrink the heap by one, so the end item is left alone.',
      'Repair the heap: move the new top down, swapping it with its bigger child, until it fits.',
      'Repeat steps 3 to 5 until the heap is empty.',
    ],
    watch: 'In the animation, a parent and its child rise together to be compared. If the child is bigger they swap, so the bigger ball moves up the heap. Each time the biggest ball moves to the end of the row, it turns green.',
    example: [
      'List: 7, 3, 8, 1, 5, 2, 6, 4.',
      'Build the heap so that 8 is at the top.',
      'Swap 8 with the last item. 8 is now in its final place at the end.',
      'Repair the heap so the next biggest, 7, is on top. Swap it to the second-last place, and so on.',
    ],
    remember: [
      'It is always O(n log n), and it needs no extra memory (O(1)).',
      'It is not stable.',
      'It is not adaptive. A sorted list still takes the same work.',
      'In practice it is often a little slower than merge sort, but it saves memory.',
    ],
    code: `void heapify(int arr[], int n, int i) {
    int largest = i;
    int l = 2 * i + 1, r = 2 * i + 2;
    if (l < n && arr[l] > arr[largest]) largest = l;
    if (r < n && arr[r] > arr[largest]) largest = r;
    if (largest != i) {
        int t = arr[i]; arr[i] = arr[largest]; arr[largest] = t;
        heapify(arr, n, largest);
    }
}

void heapSort(int arr[], int n) {
    for (int i = n / 2 - 1; i >= 0; i--) heapify(arr, n, i); // build heap
    for (int e = n - 1; e > 0; e--) {
        int t = arr[0]; arr[0] = arr[e]; arr[e] = t; // move biggest to end
        heapify(arr, e, 0);
    }
}`,
    time: 'Time: always O(n log n)', space: 'Space: O(1)',
  },
];

const SortLesson: React.FC<{ info: SortInfo; n: number }> = ({ info, n }) => {
  const [more, setMore] = useState(false);
  const [code, setCode] = useState(false);
  const P = 'text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base';
  const H4 = 'pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg';
  const LIST = 'space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base';
  const LINK = 'inline-flex items-center gap-1 text-sm font-bold text-indigo-600 underline underline-offset-4 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300';

  return (
    <section className="space-y-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-white/5 dark:bg-white/[0.03] sm:p-6">
      <h3 className="text-2xl font-extrabold text-slate-950 dark:text-white sm:text-3xl">{n}. {info.title}</h3>
      <hr className="border-t-2 border-slate-200 dark:border-slate-700" />
      <p className={P}>{info.intro}</p>
      <p className={P}>{info.analogy}</p>

      <h4 className={H4}>How it works, step by step</h4>
      <ol className={`list-decimal ${LIST}`}>
        {info.steps.map((t, i) => <li key={i}>{t}</li>)}
      </ol>

      <div
        className="grid transition-all duration-700 ease-in-out"
        style={{ gridTemplateRows: more ? '1fr' : '0fr', opacity: more ? 1 : 0 }}
        aria-hidden={!more}
      >
        <div className="min-h-0 overflow-hidden">
          <div className="space-y-4">
            <h4 className={H4}>Watch it happen</h4>
            <p className={P}>{info.watch}</p>
            <h4 className={H4}>Example</h4>
            <ul className={`list-disc ${LIST}`}>
              {info.example.map((t, i) => <li key={i}>{t}</li>)}
            </ul>
            <h4 className={H4}>Good things to remember</h4>
            <ul className={`list-disc ${LIST}`}>
              {info.remember.map((t, i) => <li key={i}>{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
      <button type="button" onClick={() => setMore((v) => !v)} aria-expanded={more} className={LINK}>
        {more ? 'Show less' : 'Show more'}
        <ChevronUp size={16} className={`transition-transform duration-500 ${more ? '' : 'rotate-180'}`} />
      </button>

      <SortAnimation algo={info.id} />

      <div className="space-y-3">
        <button type="button" onClick={() => setCode((v) => !v)} aria-expanded={code} className={LINK}>
          {code ? 'Hide code' : 'Show code'}
          <ChevronUp size={16} className={`transition-transform duration-500 ${code ? '' : 'rotate-180'}`} />
        </button>
        <div
          className="grid transition-all duration-700 ease-in-out"
          style={{ gridTemplateRows: code ? '1fr' : '0fr', opacity: code ? 1 : 0 }}
          aria-hidden={!code}
        >
          <div className="min-h-0 overflow-hidden">
            <DarkCode code={info.code} title={`${info.id}_sort.cpp`} />
          </div>
        </div>
      </div>

      <p className="flex flex-wrap items-center gap-2 text-sm text-slate-700 dark:text-slate-300 sm:text-base">
        <Hl c="text-cyan-300">{info.time}</Hl>
        <Hl c="text-emerald-300">{info.space}</Hl>
      </p>
    </section>
  );
};

export const LearningOutcome4: React.FC = () => {
  const [isDarkMode, setIsDarkMode] = useState(false);
  const [inputValue, setInputValue] = useState('');
  const [activeSectionIndex, setActiveSectionIndex] = useLessonState('section', 0);
  const [randomTip, setRandomTip] = useState<{ title: string; text: string } | null>(
    null
  );
  const [copiedId, setCopiedId] = useState<string | null>(null);
  const [showMoreLinear, setShowMoreLinear] = useState(false);
  const [showCodeLinear, setShowCodeLinear] = useState(false);
  const [showCodeBinary, setShowCodeBinary] = useState(false);
  const [showMoreBinary, setShowMoreBinary] = useState(false);

  const searchInputRef = useRef<HTMLInputElement>(null);
  const listContainerRef = useRef<HTMLDivElement>(null);
  const sectionRefs = useRef<{ [key: string]: HTMLDivElement | null }>({});

  // Dark Mode detection
  useEffect(() => {
    const checkDarkMode = () => setIsDarkMode(document.documentElement.classList.contains('dark'));
    checkDarkMode();
    const observer = new MutationObserver(checkDarkMode);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    return () => observer.disconnect();
  }, []);

  // Random tip on mount
  useEffect(() => {
    const tips = [
      {
        title: 'Did you know?',
        text: 'Binary search is one of the most efficient searching algorithms, but it requires the data to be sorted first.',
      },
      {
        title: 'Pro Tip',
        text: 'When choosing a sorting algorithm, consider stability and whether the data is partially sorted – adaptive algorithms like Insertion Sort can be faster in practice.',
      },
      {
        title: 'Memory Trick',
        text: 'Remember the difference: Linear search is like looking for a book on an unsorted shelf; binary search is like flipping through a sorted dictionary.',
      },
      {
        title: 'Common Mistake',
        text: 'Don’t forget that binary search only works on sorted arrays. Applying it to unsorted data will produce incorrect results.',
      },
    ];
    setRandomTip(tips[Math.floor(Math.random() * tips.length)]);
  }, []);

  const refreshRandomTip = () => {
    const tips = [
      {
        title: 'Did you know?',
        text: 'Binary search is one of the most efficient searching algorithms, but it requires the data to be sorted first.',
      },
      {
        title: 'Pro Tip',
        text: 'When choosing a sorting algorithm, consider stability and whether the data is partially sorted – adaptive algorithms like Insertion Sort can be faster in practice.',
      },
      {
        title: 'Memory Trick',
        text: 'Remember the difference: Linear search is like looking for a book on an unsorted shelf; binary search is like flipping through a sorted dictionary.',
      },
      {
        title: 'Common Mistake',
        text: 'Don’t forget that binary search only works on sorted arrays. Applying it to unsorted data will produce incorrect results.',
      },
    ];
    setRandomTip(tips[Math.floor(Math.random() * tips.length)]);
  };

  // Scroll to section when tab changes
  const scrollToSection = (index: number) => {
    setActiveSectionIndex(index);
    const tab = SECTION_TABS[index];
    const element = sectionRefs.current[tab.id];
    if (element) {
      const scrollArea = document.getElementById('lesson-scroll-area');
      if (scrollArea) {
        const scrollAreaRect = scrollArea.getBoundingClientRect();
        const elementRect = element.getBoundingClientRect();
        scrollArea.scrollTo({
          top: elementRect.top - scrollAreaRect.top + scrollArea.scrollTop - 72,
          behavior: 'smooth',
        });
      } else {
        const y = element.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    }
  };

  // ─── Sticky Navigation ────────────────────────────────────────────────────
  const NavTabs = () => (
    <div className="sticky top-0 z-30 bg-white/80 dark:bg-[#0a0a0b]/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 py-2 px-[5px] sm:px-6 md:px-8 shadow-sm">
      <div className="flex items-center gap-2 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {SECTION_TABS.map((tab, idx) => (
          <button
            key={tab.id}
            onClick={() => scrollToSection(idx)}
            className={`whitespace-nowrap rounded-full px-4 py-1.5 text-xs font-semibold transition-colors ${
              activeSectionIndex === idx
                ? 'bg-indigo-600 text-white shadow-md shadow-indigo-200 dark:shadow-indigo-900/30'
                : 'bg-white dark:bg-[#1a1a1a] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800'
            }`}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>
  );

  // ─── Main container classes ─────────────────────────────────────────────
  const containerClasses = isDarkMode
    ? 'min-h-screen bg-[#0a0a0b] text-slate-200'
    : 'min-h-screen bg-slate-50 text-slate-900';

  // ─── Copy to clipboard ──────────────────────────────────────────────────
  const copyToClipboard = (code: string, id: string) => {
    navigator.clipboard.writeText(code);
    setCopiedId(id);
    setTimeout(() => setCopiedId(null), 2000);
  };

  // ─── Syntax highlighting (same as LO1) ────────────────────────────────
  const highlightSyntax = (code: string): React.ReactNode => {
    let escaped = code
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    const placeholders: Record<string, string> = {};
    let counter = 0;

    // Comments
    escaped = escaped.replace(/(\/\/.*?$|\/\*[\s\S]*?\*\/)/gm, (match) => {
      const key = `__COMMENT_${counter++}__`;
      placeholders[key] = `<span class="text-[#57A64A] dark:text-[#6a9955] italic">${match}</span>`;
      return key;
    });

    // Strings
    escaped = escaped.replace(/(".*?"|'.*?'|`.*?`)/g, (match) => {
      const key = `__STRING_${counter++}__`;
      placeholders[key] = `<span class="text-[#D69D85] dark:text-[#ce9178]">${match}</span>`;
      return key;
    });

    // Keywords
    const keywords = [
      'int', 'void', 'char', 'double', 'float', 'if', 'else', 'return', 'for',
      'while', 'do', 'break', 'continue', 'switch', 'case', 'default', 'class',
      'struct', 'public', 'private', 'protected', 'namespace', 'using', 'include',
      'define', 'endl', 'cout', 'cin', 'new', 'delete', 'this', 'virtual', 'override',
      'static', 'const', 'enum', 'template', 'typename', 'try', 'catch', 'throw',
      'main'
    ];
    const keywordRegex = new RegExp(`\\b(${keywords.join('|')})\\b`, 'g');
    escaped = escaped.replace(keywordRegex, '<span class="text-[#1e40af] dark:text-[#569CD6] font-semibold">$1</span>');

    // Primitive types
    const types = ['int', 'char', 'double', 'float', 'bool', 'void', 'string'];
    const typeRegex = new RegExp(`\\b(${types.join('|')})\\b`, 'g');
    escaped = escaped.replace(typeRegex, '<span class="text-[#1d4ed8] dark:text-[#4ec9b0]">$1</span>');

    // Preprocessor directives
    escaped = escaped.replace(/^#include.*$/gm, '<span class="text-[#c586c0]">$&</span>');

    // Known functions (like linearSearch, binarySearch)
    const functions = ['linearSearch', 'binarySearch'];
    const funcRegex = new RegExp(`\\b(${functions.join('|')})\\b`, 'g');
    escaped = escaped.replace(funcRegex, '<span class="text-[#DCDCAA]">$1</span>');

    // Methods (words followed by '(')
    escaped = escaped.replace(/(?<![<>"'])\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\s*\()/g, '<span class="text-[#DCDCAA]">$1</span>');

    // Numbers
    escaped = escaped.replace(/\b(\d+(\.\d+)?)\b/g, '<span class="text-[#16a34a] dark:text-[#b5cea8]">$1</span>');

    Object.keys(placeholders).forEach(key => {
      escaped = escaped.replace(key, placeholders[key]);
    });

    const lines = escaped.split('\n');
    return lines.map((line, idx) => (
      <div key={idx} className="flex min-h-[1.5rem] hover:bg-gray-100/50 dark:hover:bg-gray-700/30 rounded-md transition-colors">
        <span className="text-right w-8 select-none text-gray-400 dark:text-gray-500 text-xs pr-3 mr-3 border-r border-gray-200 dark:border-gray-700 shrink-0">
          {idx + 1}
        </span>
        <pre
          className="m-0 flex-1 overflow-x-auto text-xs md:text-sm font-mono leading-relaxed text-gray-800 dark:text-gray-200 whitespace-pre-wrap break-words"
          dangerouslySetInnerHTML={{ __html: line || ' ' }}
        />
      </div>
    ));
  };

  // ─── CodeBlock component ────────────────────────────────────────────────
  const CodeBlock = ({ code, title, id }: { code: string; title: string; id: string }) => (
    <div className="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 shadow-md hover:shadow-lg transition-shadow duration-300">
      <div className="flex justify-between items-center px-4 py-2 bg-slate-100 dark:bg-[#1a1a1a] border-b border-slate-200 dark:border-slate-700">
        <span className="text-sm font-mono text-slate-700 dark:text-slate-300 font-medium">{title}</span>
        <button
          onClick={() => copyToClipboard(code, id)}
          className="px-3 py-1 rounded-md text-xs transition-all flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-sm"
        >
          {copiedId === id ? <Check size={12} /> : <Copy size={12} />}
          {copiedId === id ? 'Copied!' : 'Copy'}
        </button>
      </div>
      <div className="bg-white dark:bg-[#0a0a0b] p-4 overflow-x-auto">
        {highlightSyntax(code)}
      </div>
    </div>
  );

  // ─── Table component ────────────────────────────────────────────────────
  const Table = ({ headers, rows, title }: { headers: string[]; rows: string[][]; title?: string }) => (
    <div className="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700 shadow-md">
      {title && (
        <div className="px-4 py-2 font-semibold bg-slate-100 dark:bg-[#1a1a1a] border-b border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200">
          {title}
        </div>
      )}
      <table className="w-full border-collapse text-sm">
        <thead className="bg-slate-100 dark:bg-[#1a1a1a]">
          <tr>
            {headers.map((header, i) => (
              <th key={i} className="border border-slate-200 dark:border-slate-700 p-3 text-left font-semibold text-slate-800 dark:text-slate-200">
                {header}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr key={i} className={i % 2 === 0 ? 'bg-white dark:bg-[#0a0a0b]' : 'bg-slate-50 dark:bg-[#121212]'}>
              {row.map((cell, j) => (
                <td key={j} className="border border-slate-200 dark:border-slate-700 p-3 text-slate-700 dark:text-slate-300">
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );

  // ─── Code snippets ──────────────────────────────────────────────────────
  const linearSearchCode = `#include <iostream>
using namespace std;

int linearSearch(int arr[], int size, int target) {
    for (int i = 0; i < size; i++) {
        if (arr[i] == target) {
            return i; // Return the index of the target
        }
    }
    return -1; // Target not found
}

int main() {
    int arr[] = {2, 4, 6, 8, 10};
    int target = 6;
    int size = sizeof(arr) / sizeof(arr[0]);
    int result = linearSearch(arr, size, target);
    if (result != -1) {
        cout << "Element found at index: " << result << endl;
    } else {
        cout << "Element not found" << endl;
    }
    return 0;
}`;

  const binarySearchCode = `#include <iostream>
using namespace std;

int binarySearch(int arr[], int l, int r, int x) {
    while (l <= r) {
        int m = l + (r - l) / 2;
        if (arr[m] == x) return m;
        if (arr[m] < x) l = m + 1;
        else r = m - 1;
    }
    return -1;
}

int main() {
    int arr[] = {2, 3, 4, 10, 40};
    int x = 10;
    int n = sizeof(arr) / sizeof(arr[0]);
    int result = binarySearch(arr, 0, n - 1, x);
    if (result == -1) cout << "Element is not present in array" << endl;
    else cout << "Element is present at index " << result << endl;
    return 0;
}`;

  // ─── Return ─────────────────────────────────────────────────────────────
  return (
    <div className={containerClasses}>
      {/* ─── Header ───────────────────────────────────────────────────────── */}
      <header className="bg-[#78350f] dark:bg-[#451a03] border-b border-amber-800/80 pt-10 pb-8 shadow-sm">
        <div className="mx-auto px-[5px] sm:px-6 md:px-8">
          <div className="inline-block px-3 py-1 bg-white/20 text-white rounded-full text-xs font-bold mb-4 backdrop-blur-sm">
            <Search size={14} className="inline mr-1" /> SEARCHING & SORTING
          </div>
          <h1 className="text-3xl md:text-5xl font-extrabold text-white mb-2 tracking-tight">
            Learning Outcome 4{' '}
            <span className="text-amber-300 font-bold italic">
              Simply Easy Search & Sort
            </span>
          </h1>
          <p className="text-lg text-indigo-100 max-w-2xl leading-relaxed">
            Master the fundamentals of searching and sorting algorithms: linear
            search, binary search, bubble sort, selection sort, merge sort, and
            more. Understand their complexities and when to use each.
          </p>
          <div className="mt-4 flex flex-wrap items-center gap-3 text-sm text-indigo-100">
            <span className="bg-white/10 px-3 py-1 rounded-full">
              📚 {SECTION_TABS.length} sections
            </span>
            <span className="bg-white/10 px-3 py-1 rounded-full">
              <Search size={14} className="inline mr-1" /> Searching
            </span>
            <span className="bg-white/10 px-3 py-1 rounded-full">
              <SortAsc size={14} className="inline mr-1" /> Sorting
            </span>
          </div>

          {/* Search Bar inline */}
          <div className="mt-6 max-w-xl">
            <div className="flex items-center bg-white/10 backdrop-blur-sm rounded-xl border border-white/20 focus-within:ring-2 focus-within:ring-white/50 transition-all">
              <Search className="ml-4 text-indigo-200" size={20} />
              <input
                ref={searchInputRef}
                type="text"
                value={inputValue}
                onChange={(e) => setInputValue(e.target.value)}
                placeholder="Search for an algorithm, complexity, or concept..."
                className="w-full bg-transparent border-none outline-none py-3 px-3 text-white placeholder-indigo-200/70 font-medium"
              />
              {inputValue && (
                <button
                  onClick={() => {
                    setInputValue('');
                    searchInputRef.current?.focus();
                  }}
                  className="mr-3 p-1.5 hover:bg-white/20 rounded-full transition-colors"
                >
                  <X size={18} className="text-indigo-200" />
                </button>
              )}
            </div>
          </div>
        </div>
      </header>

      {/* ─── Sticky Navigation ────────────────────────────────────────────── */}
      <NavTabs />

      {/* ─── Main Content ────────────────────────────────────────────────── */}
      <div className="mx-auto px-[5px] sm:px-6 md:px-8 py-8">
        <div className="grid grid-cols-1 gap-8">
          {/* Left column: sections */}
          <div ref={listContainerRef} className="space-y-12">
            {/* ─── Section 1: Introduction ─────────────────────────────── */}
            <div
              ref={(el) => { sectionRefs.current['intro'] = el; }}
              className="scroll-mt-24 p-4 sm:p-6 bg-white dark:bg-[#121212] rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-4"
            >
              <h2 className="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-2 uppercase">
                Introduction to Searching & Sorting
              </h2>

              <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                Every app is full of data, like contacts, marks and products. Two jobs come up all the time:
                <strong className="text-slate-950 dark:text-white"> searching</strong>, which means finding one item, and
                <strong className="text-slate-950 dark:text-white"> sorting</strong>, which means putting items in order.
                Each job has many algorithms, which are step-by-step methods for doing it.
              </p>

              <section className="pt-2">
                <h3 className="text-lg font-bold text-slate-950 dark:text-white sm:text-xl">Why do we need to search and sort?</h3>
                <ol className="mt-1 list-decimal space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  <li><strong className="text-slate-950 dark:text-white">Data grows.</strong> With 10 names you can read the whole list. With a million, that takes far too long.</li>
                  <li><strong className="text-slate-950 dark:text-white">Order saves time.</strong> In a messy list you must check every item. In an ordered list you can skip big parts.</li>
                  <li><strong className="text-slate-950 dark:text-white">Methods differ.</strong> Some are fast but use more memory, so we compare them using Big O.</li>
                </ol>
              </section>

              <section className="pt-2">
                <h3 className="text-lg font-bold text-slate-950 dark:text-white sm:text-xl">The two types you will learn</h3>
                <ol className="mt-1 list-decimal space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  <li>
                    <strong className="text-slate-950 dark:text-white">Searching algorithms:</strong> finding an item.
                    <ul className="mt-1 list-disc space-y-0.5 pl-6">
                      <li>Linear search</li>
                      <li>Binary search</li>
                    </ul>
                  </li>
                  <li>
                    <strong className="text-slate-950 dark:text-white">Sorting algorithms:</strong> putting items in order.
                    <ul className="mt-1 list-disc space-y-0.5 pl-6">
                      <li>Bubble sort</li>
                      <li>Selection sort</li>
                      <li>Insertion sort</li>
                      <li>Shell sort</li>
                      <li>Merge sort</li>
                      <li>Heap sort</li>
                    </ul>
                  </li>
                </ol>
              </section>
            </div>

            {/* ─── Section 2: Searching ──────────────────────────────────── */}
            <div
              ref={(el) => { sectionRefs.current['searching'] = el; }}
              className="scroll-mt-24 p-4 sm:p-6 bg-white dark:bg-[#121212] rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-4"
            >
              <h2 className="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-4 uppercase">
                Searching Algorithms
              </h2>

              <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                A searching algorithm finds one item in a collection. Which one to use depends on whether the data is sorted and how big it is.
              </p>

              <section className="pt-2">
                <h3 className="text-lg font-bold text-slate-950 dark:text-white sm:text-xl">Types of Searching Algorithms</h3>
                <p className="mt-1 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  There are two main types. Here is what each one does.
                </p>
                <ol className="mt-2 list-decimal space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  <li><strong className="text-slate-950 dark:text-white">Linear search:</strong> check the items one by one until you find the target. It works on any list, even a messy one.</li>
                  <li><strong className="text-slate-950 dark:text-white">Binary search:</strong> check the middle and throw away half the list each time. It is much faster, but the list must be sorted first.</li>
                </ol>
              </section>

              <section className="space-y-4 pt-4">
                <hr className="mb-4 border-t-2 border-slate-200 dark:border-slate-700" />
                <h3 className="text-2xl font-extrabold text-slate-950 dark:text-white sm:text-3xl">1. Linear Search</h3>
                <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  Linear search is the simplest way to find something in a list. You start at the <strong className="text-slate-950 dark:text-white">first item</strong> and look at the items <strong className="text-slate-950 dark:text-white">one by one</strong>, moving forward, until you find the one you want or the list runs out.
                </p>
                <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  Think of a paper list of student names. You run your finger down from the top, checking each name, until you see the one you are looking for. That is linear search.
                </p>

                <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">How it works, step by step</h4>
                <ol className="list-decimal space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  <li>Decide what you are looking for. This is called the <Hl c="text-cyan-300">target</Hl>.</li>
                  <li>Start at the first item, which is at <Hl c="text-cyan-300">index 0</Hl>.</li>
                  <li>Compare that item with the target. Are they equal?</li>
                  <li>If they are equal, stop. <Hl c="text-lime-300">Return the index</Hl> where you found it.</li>
                  <li>If they are not equal, move to the next item and compare again.</li>
                  <li>If you reach the end of the list and never found a match, return <Hl c="text-yellow-300">-1</Hl>. This means not found.</li>
                </ol>

                <div
                  className="grid transition-all duration-700 ease-in-out"
                  style={{ gridTemplateRows: showMoreLinear ? '1fr' : '0fr', opacity: showMoreLinear ? 1 : 0 }}
                  aria-hidden={!showMoreLinear}
                >
                  <div className="min-h-0 overflow-hidden">
                    <div className="space-y-4">
                      <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">Watch it happen</h4>
                <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  In the animation below, the search is looking for <strong className="text-slate-950 dark:text-white">18</strong>. Each ball is lifted up and compared with the 18 ball. If the numbers are not equal, the equal sign gets a red line through it, the ball shakes, and the search moves on. When the numbers match, you get a green tick.
                </p>

                <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">Example</h4>
                <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  List: <Hl c="text-white">4, 9, 15, 22, 6, 31, 18, 2, 27, 11</Hl> and the target is <Hl c="text-white">18</Hl>.
                </p>
                <ul className="list-disc space-y-1 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  <li>Check 4, then 9, 15, 22, 6 and 31. None of them is 18, so keep going.</li>
                  <li>The next item is 18. It matches, so stop.</li>
                  <li>18 is at <Hl c="text-lime-300">index 6</Hl>, so the answer is 6. It took 7 comparisons.</li>
                </ul>

                <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">Good things to remember</h4>
                <ul className="list-disc space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  <li><strong className="text-slate-950 dark:text-white">The list does not need to be sorted.</strong> Linear search checks every item, so the order does not matter.</li>
                  <li><strong className="text-slate-950 dark:text-white">Why -1 for not found?</strong> Indexes start at 0, so -1 can never be a real position. That makes it a safe way to say "not found".</li>
                  <li><strong className="text-slate-950 dark:text-white">Best case:</strong> the target is the first item, so you need only 1 check.</li>
                  <li><strong className="text-slate-950 dark:text-white">Worst case:</strong> the target is the last item or is not in the list, so you check all n items.</li>
                  <li><strong className="text-slate-950 dark:text-white">It is slow on huge lists.</strong> With a million items you might need a million checks. That is why binary search exists.</li>
                </ul>
                    </div>
                  </div>
                </div>
                <button
                  type="button"
                  onClick={() => setShowMoreLinear((v) => !v)}
                  aria-expanded={showMoreLinear}
                  className="inline-flex items-center gap-1 text-sm font-bold text-indigo-600 underline underline-offset-4 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
                >
                  {showMoreLinear ? 'Show less' : 'Show more'}
                  <ChevronUp size={16} className={`transition-transform duration-500 ${showMoreLinear ? '' : 'rotate-180'}`} />
                </button>
                <div className="flex flex-col gap-4">
                  <LinearSearchAnimation />
                  <div className="space-y-3">
                    <button
                      type="button"
                      onClick={() => setShowCodeLinear((v) => !v)}
                      aria-expanded={showCodeLinear}
                      className="inline-flex items-center gap-1 text-sm font-bold text-indigo-600 underline underline-offset-4 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
                    >
                      {showCodeLinear ? 'Hide code' : 'Show code'}
                      <ChevronUp size={16} className={`transition-transform duration-500 ${showCodeLinear ? '' : 'rotate-180'}`} />
                    </button>
                    <div
                      className="grid transition-all duration-700 ease-in-out"
                      style={{ gridTemplateRows: showCodeLinear ? '1fr' : '0fr', opacity: showCodeLinear ? 1 : 0 }}
                      aria-hidden={!showCodeLinear}
                    >
                      <div className="min-h-0 overflow-hidden">
                        <DarkCode code={linearSearchCode} title="linear_search.cpp" />
                      </div>
                    </div>
                  </div>
                </div>
                <p className="flex flex-wrap items-center gap-2 text-sm text-slate-700 dark:text-slate-300 sm:text-base">
                  <Hl c="text-cyan-300">Time: best O(1), worst O(n)</Hl>
                  <Hl c="text-emerald-300">Space: O(1)</Hl>
                </p>
              </section>

              <section className="space-y-4 pt-6">
                <hr className="mb-4 border-t-2 border-slate-200 dark:border-slate-700" />
                <h3 className="text-2xl font-extrabold text-slate-950 dark:text-white sm:text-3xl">2. Binary Search</h3>
                <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  Binary search is a much faster way to find something, but it only works when the list is <strong className="text-slate-950 dark:text-white">already sorted</strong>. Instead of checking every item, you look at the <strong className="text-slate-950 dark:text-white">middle item</strong> and use it to throw away half of the list in one go.
                </p>
                <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  Think of a dictionary. To find a word you do not start at page 1. You open the book near the middle, see if your word comes before or after that page, and then ignore the half that cannot have it. You keep doing that until you find the word.
                </p>

                <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">How it works, step by step</h4>
                <ol className="list-decimal space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                  <li>Make sure the list is sorted. Set <Hl c="text-cyan-300">low</Hl> to the first index and <Hl c="text-cyan-300">high</Hl> to the last index. In the code these are called <Hl c="text-cyan-300">l</Hl> and <Hl c="text-cyan-300">r</Hl>.</li>
                  <li>Find the <Hl c="text-yellow-300">middle</Hl> index, halfway between low and high.</li>
                  <li>Compare the middle item with the target. If they are equal, stop and <Hl c="text-lime-300">return the middle index</Hl>.</li>
                  <li>If the middle item is <strong className="text-slate-950 dark:text-white">too small</strong>, the target must be on the right. Move low to just after the middle.</li>
                  <li>If the middle item is <strong className="text-slate-950 dark:text-white">too big</strong>, the target must be on the left. Move high to just before the middle.</li>
                  <li>Repeat from step 2. If low ends up bigger than high, nothing is left to check, so return <Hl c="text-yellow-300">-1</Hl>. This means not found.</li>
                </ol>

                <div
                  className="grid transition-all duration-700 ease-in-out"
                  style={{ gridTemplateRows: showMoreBinary ? '1fr' : '0fr', opacity: showMoreBinary ? 1 : 0 }}
                  aria-hidden={!showMoreBinary}
                >
                  <div className="min-h-0 overflow-hidden">
                    <div className="space-y-4">
                      <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">Watch it happen</h4>
                      <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                        In the animation below, the search is looking for <strong className="text-slate-950 dark:text-white">61</strong> in a sorted list of 24 balls. The middle ball is lifted up and compared with the 23 ball. If they are not equal, the equal sign gets a red line through it and the ball shakes. Then the half that cannot hold 61 disappears, and the balls that are left slide to the centre and grow bigger. When the numbers match, you get a green tick.
                      </p>

                      <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">Example</h4>
                      <p className="text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                        List: <Hl c="text-white">2, 5, 8, 12, 15, 19, 23, 28, 31, 36, 40, 44, 49, 53, 57, 61, 66, 70, 74, 79, 83, 88, 92, 97</Hl> and the target is <Hl c="text-white">61</Hl>.
                      </p>
                      <ul className="list-disc space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                        <li>Low is 0 and high is 23, so the middle is index 11, which holds 44. 44 is too small, so throw away the left half. Low becomes 12.</li>
                        <li>Low is 12 and high is 23, so the middle is index 17, which holds 70. 70 is too big, so throw away the right half. High becomes 16.</li>
                        <li>Low is 12 and high is 16, so the middle is index 14, which holds 57. 57 is too small, so low becomes 15.</li>
                        <li>Low is 15 and high is 16, so the middle is index 15, which holds 61. It matches, so stop.</li>
                        <li>61 is at <Hl c="text-lime-300">index 15</Hl>. It took only 4 comparisons. Linear search would have needed 16.</li>
                      </ul>

                      <h4 className="pt-2 text-base font-bold text-slate-950 dark:text-white sm:text-lg">Good things to remember</h4>
                      <ul className="list-disc space-y-2 pl-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300 sm:text-base">
                        <li><strong className="text-slate-950 dark:text-white">The list must be sorted.</strong> If it is not, throwing away half the list can throw away the answer, and the result will be wrong.</li>
                        <li><strong className="text-slate-950 dark:text-white">It halves the work each time.</strong> A list of 1,000 items needs about 10 checks. A list of 1,000,000 items needs only about 20.</li>
                        <li><strong className="text-slate-950 dark:text-white">Best case:</strong> the target is exactly in the middle, so you need only 1 check.</li>
                        <li><strong className="text-slate-950 dark:text-white">Worst case:</strong> you keep halving until one item is left, which is about log n checks.</li>
                        <li><strong className="text-slate-950 dark:text-white">Why l + (r - l) / 2?</strong> It gives the middle index and avoids overflow when the numbers are very large.</li>
                        <li><strong className="text-slate-950 dark:text-white">Sorting costs time.</strong> On a small or unsorted list, linear search can be the better choice.</li>
                      </ul>
                    </div>
                  </div>
                </div>
                <button
                  type="button"
                  onClick={() => setShowMoreBinary((v) => !v)}
                  aria-expanded={showMoreBinary}
                  className="inline-flex items-center gap-1 text-sm font-bold text-indigo-600 underline underline-offset-4 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
                >
                  {showMoreBinary ? 'Show less' : 'Show more'}
                  <ChevronUp size={16} className={`transition-transform duration-500 ${showMoreBinary ? '' : 'rotate-180'}`} />
                </button>
                <BinarySearchAnimation />
                <div className="space-y-3">
                    <button
                      type="button"
                      onClick={() => setShowCodeBinary((v) => !v)}
                      aria-expanded={showCodeBinary}
                      className="inline-flex items-center gap-1 text-sm font-bold text-indigo-600 underline underline-offset-4 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
                    >
                      {showCodeBinary ? 'Hide code' : 'Show code'}
                      <ChevronUp size={16} className={`transition-transform duration-500 ${showCodeBinary ? '' : 'rotate-180'}`} />
                    </button>
                    <div
                      className="grid transition-all duration-700 ease-in-out"
                      style={{ gridTemplateRows: showCodeBinary ? '1fr' : '0fr', opacity: showCodeBinary ? 1 : 0 }}
                      aria-hidden={!showCodeBinary}
                    >
                      <div className="min-h-0 overflow-hidden">
                        <DarkCode code={binarySearchCode} title="binary_search.cpp" />
                      </div>
                    </div>
                  </div>
                <p className="flex flex-wrap items-center gap-2 text-sm text-slate-700 dark:text-slate-300 sm:text-base">
                  <Hl c="text-cyan-300">Time: O(log n)</Hl>
                  <Hl c="text-emerald-300">Space: O(1)</Hl>
                </p>
              </section>
            </div>

            {/* ─── Section 3: Search Comparison ──────────────────────────── */}
            <div
              ref={(el) => { sectionRefs.current['search-comparison'] = el; }}
              className="scroll-mt-24 p-4 sm:p-6 bg-white dark:bg-[#121212] rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-4"
            >
              <h2 className="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-4 uppercase">
                Comparison of Searching Algorithms
              </h2>

              <div className="overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-[#0a0a0b]">
                <div className="grid grid-cols-2 bg-slate-100 dark:bg-[#1a1a1a]">
                  <div className="px-5 py-4 text-base font-bold text-slate-950 dark:text-white">Linear Search</div>
                  <div className="border-l border-slate-200 px-5 py-4 text-base font-bold text-slate-950 dark:border-slate-700 dark:text-white">Binary Search</div>
                </div>
                {[
                  ["Time complexity (worst)", "O(n)", "O(log n)"],
                  ["Space complexity", "O(1)", "O(1)"],
                  ["Precondition", "None. It works on any list.", "The list must be sorted."],
                  ["Efficiency", "Slower on large lists because it may check every item.", "Much faster on large lists because it halves the list each time."],
                  ["Use cases", "Unsorted or small collections.", "Large sorted collections."],
                ].map(([label, lin, bin], i) => (
                  <div key={i} className="grid grid-cols-2 border-t border-slate-200 dark:border-slate-700">
                    <div className="px-5 py-3">
                      <div className="text-sm font-bold text-slate-950 dark:text-white sm:text-base">{label}</div>
                      <div className="text-sm text-slate-700 dark:text-slate-300 sm:text-base">{lin}</div>
                    </div>
                    <div className="border-l border-slate-200 px-5 py-3 dark:border-slate-700">
                      <div className="text-sm font-bold text-slate-950 dark:text-white sm:text-base">{label}</div>
                      <div className="text-sm text-slate-700 dark:text-slate-300 sm:text-base">{bin}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* ─── Section 4: Sorting ─────────────────────────────────────── */}
            <div
              ref={(el) => { sectionRefs.current['sorting'] = el; }}
              className="scroll-mt-24 p-4 sm:p-6 bg-white dark:bg-[#121212] rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-4"
            >
              <h2 className="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-4 uppercase">
                Sorting Algorithms
              </h2>

              <p className="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                Sorting arranges elements in a specific order (ascending or descending). Different algorithms
                have different properties: in-place vs extra space, stable vs unstable, adaptive vs non-adaptive.
              </p>

              <div className="p-4 bg-slate-50 dark:bg-white/[0.03] rounded-xl border border-slate-100 dark:border-white/5 mt-4">
                <h4 className="text-xs font-bold text-indigo-600 dark:text-indigo-400">Sorting Algorithm Properties</h4>
                <ul className="list-disc pl-5 space-y-1 text-sm text-slate-600 dark:text-slate-400">
                  <li><strong>In‑Place:</strong> Sorts within original array, using O(1) extra space. Examples: Bubble, Selection, Insertion, Heap, Quick.</li>
                  <li><strong>Not In‑Place:</strong> Requires additional space (usually O(n)). Example: Merge Sort.</li>
                  <li><strong>Stable:</strong> Maintains relative order of equal elements. Examples: Bubble, Insertion, Merge.</li>
                  <li><strong>Unstable:</strong> Does not preserve relative order. Examples: Selection, Shell, Heap, Quick.</li>
                  <li><strong>Adaptive:</strong> Takes advantage of initial order to improve performance. Examples: Bubble, Insertion, Shell.</li>
                  <li><strong>Non‑Adaptive:</strong> Performs same operations regardless of input. Examples: Selection, Merge, Heap.</li>
                </ul>
              </div>

              <div className="space-y-8 pt-2">
                {SORT_LESSONS.map((info, i) => (
                  <SortLesson key={info.id} info={info} n={i + 1} />
                ))}
              </div>
            </div>

            {/* ─── Section 5: Sorting Comparison ──────────────────────────── */}
            <div
              ref={(el) => { sectionRefs.current['sorting-comparison'] = el; }}
              className="scroll-mt-24 p-4 sm:p-6 bg-white dark:bg-[#121212] rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-4"
            >
              <h2 className="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-4 uppercase">
                Comparison of Sorting Algorithms
              </h2>

              <div className="overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-[#0a0a0b]">
                <div className="grid grid-cols-2 bg-slate-100 dark:bg-[#1a1a1a]">
                  <div className="px-5 py-4 text-base font-bold text-slate-950 dark:text-white">Bubble, Selection, Insertion, Shell</div>
                  <div className="border-l border-slate-200 px-5 py-4 text-base font-bold text-slate-950 dark:border-slate-700 dark:text-white">Merge, Heap</div>
                </div>
                {[
                  ["Speed", "Slow on big lists. In the worst case the work grows like n × n, which is O(n²).", "Fast on big lists. The work grows like n log n, which is O(n log n)."],
                  ["Extra memory", "Use no extra memory (O(1)). They sort inside the same array.", "Heap uses no extra memory (O(1)). Merge needs a second array of the same size (O(n))."],
                  ["Stable (keeps equal items in order)", "Bubble and Insertion are stable. Selection and Shell are not.", "Merge is stable. Heap is not."],
                  ["Adaptive (faster on a nearly sorted list)", "Bubble, Insertion and Shell get faster. Selection does not.", "Neither one does. They do the same work whatever the order."],
                  ["Best case", "Bubble and Insertion take only O(n) on a sorted list. Selection still takes O(n²).", "Always O(n log n), even if the list is already sorted."],
                  ["Use when", "The list is small or almost sorted.", "The list is large and you need steady speed."],
                ].map(([label, a, b], i) => (
                  <div key={i} className="grid grid-cols-2 border-t border-slate-200 dark:border-slate-700">
                    <div className="px-5 py-3">
                      <div className="text-sm font-bold text-slate-950 dark:text-white sm:text-base">{label}</div>
                      <div className="text-sm text-slate-700 dark:text-slate-300 sm:text-base">{a}</div>
                    </div>
                    <div className="border-l border-slate-200 px-5 py-3 dark:border-slate-700">
                      <div className="text-sm font-bold text-slate-950 dark:text-white sm:text-base">{label}</div>
                      <div className="text-sm text-slate-700 dark:text-slate-300 sm:text-base">{b}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* ─── Section 6: Exam Tips ──────────────────────────────────── */}
            <div
              ref={(el) => { sectionRefs.current['exam-tips'] = el; }}
              className="scroll-mt-24 p-4 sm:p-6 bg-white dark:bg-[#121212] rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-4"
            >
              <h2 className="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-4 uppercase">
                Exam Tips & Cheat Sheet
              </h2>

              <div className="space-y-4">
                {[
                  {
                    Icon: Search, title: 'Searching', sub: 'Finding one item',
                    bar: 'bg-indigo-500',
                    icon: 'bg-indigo-100 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300',
                    rows: [
                      ['Linear Search', 'O(n). Works on unsorted data. Simple.'],
                      ['Binary Search', 'O(log n). Needs a sorted array.'],
                      ['Precondition', 'Binary search needs sorted data.'],
                      ['Space', 'Both are O(1) when written with a loop.'],
                    ],
                  },
                  {
                    Icon: SortAsc, title: 'Sorting: O(n²) algorithms', sub: 'Simple, but slow on big lists',
                    bar: 'bg-orange-500',
                    icon: 'bg-orange-100 text-orange-700 dark:bg-orange-500/20 dark:text-orange-300',
                    rows: [
                      ['Bubble', 'Stable, adaptive, O(n) best case.'],
                      ['Selection', 'Unstable, not adaptive, always O(n²).'],
                      ['Insertion', 'Stable, adaptive, O(n) best case.'],
                      ['Shell', <>Unstable, adaptive, O(n<sup>1.5</sup>) average.</>],
                    ],
                  },
                  {
                    Icon: Layers, title: 'Sorting: O(n log n) algorithms', sub: 'Fast, good for big lists',
                    bar: 'bg-emerald-500',
                    icon: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300',
                    rows: [
                      ['Merge', 'Stable, not in-place, O(n) space.'],
                      ['Heap', 'Unstable, in-place, O(1) space.'],
                      ['Quick', 'Average O(n log n), in-place, unstable.'],
                      ['Choosing', 'Think about stability, space and data size.'],
                    ],
                  },
                ].map(({ Icon, title, sub, bar, icon, rows }) => (
                  <div key={title} className="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-[#0a0a0b]">
