                    <div className="divide-y divide-slate-200 dark:divide-slate-700">
                      {rows.map(([label, text], i) => (
                        <div key={i} className="grid grid-cols-[6.5rem_1fr] gap-3 px-4 py-2.5 text-sm sm:grid-cols-[9rem_1fr] sm:text-base">
                          <div className="font-bold text-slate-950 dark:text-white">{label}</div>
                          <div className="text-slate-700 dark:text-slate-300">{text}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              <div className="mt-6 overflow-hidden rounded-xl border border-amber-200 bg-amber-50 dark:border-amber-500/30 dark:bg-amber-900/20">
                <div className="flex items-center gap-2 border-b border-amber-200 bg-amber-100 px-4 py-2.5 dark:border-amber-500/30 dark:bg-amber-900/30">
                  <GraduationCap size={18} className="text-amber-700 dark:text-amber-300" />
                  <span className="text-sm font-extrabold uppercase tracking-wide text-amber-800 dark:text-amber-300">Exam Tip</span>
                </div>
                <div className="space-y-3 p-4">
                  <p className="text-sm font-semibold text-slate-700 dark:text-slate-300 sm:text-base">Questions that come up a lot:</p>
                  <ul className="space-y-2">
                    {['Compare linear and binary search.', 'Explain the properties of stable and in-place sorting.'].map((q) => (
                      <li key={q} className="rounded-lg border border-amber-200 bg-white px-3 py-2 text-sm font-bold text-slate-900 dark:border-amber-500/30 dark:bg-black/30 dark:text-white sm:text-base">
                        {q}
                      </li>
                    ))}
                  </ul>
                  <p className="text-sm font-semibold text-slate-700 dark:text-slate-300 sm:text-base">Know the trade-offs:</p>
                  <div className="flex flex-wrap gap-2">
                    {['Time vs space', 'Stability', 'Adaptiveness'].map((t) => (
                      <span key={t} className="rounded-full bg-amber-500 px-3 py-1 text-xs font-extrabold text-white sm:text-sm">{t}</span>
                    ))}
                  </div>
                </div>
              </div>

              <div className="mt-6 p-6 bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl text-white shadow-lg text-center">
                <p className="text-xl font-bold">Search it. Sort it. Master it. 🚀</p>
              </div>
            </div>
          </div>

        </div>
      </div>

      {/* ─── Floating Scroll-to-Top ──────────────────────────────────────── */}
      <div className="fixed bottom-6 right-6 z-50">
        <button
          onClick={() => {
